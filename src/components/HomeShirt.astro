---
import ShirtProduct from "./commerce/ShirtProduct.astro";
---

<section class="home-shirt" aria-labelledby="home-shirt-title" data-home-mark-surface="black">
  <ShirtProduct titleId="home-shirt-title" storyHref="/tienda#shirt-story-title" />
</section>

<style>
  .home-shirt {
    padding: clamp(2.5rem, 6vw, 5.5rem) clamp(1rem, 3vw, 2.5rem);
    background-color: var(--color-black-papers);
    background-image: var(--imperio-dot-pattern);
    background-size: var(--imperio-dot-pattern-size);
  }
</style>
