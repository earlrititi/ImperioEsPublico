---
import { Eye } from "lucide";
interface Props { name?: string; label?: string; autocomplete?: string; isNew?: boolean; }
const { name = "password", label = "Contraseña", autocomplete = "current-password", isNew = false } = Astro.props;
---
<label class="password-label" for={name}>{label}</label>
<div class="password-field">
  <input id={name} name={name} type="password" autocomplete={autocomplete} minlength={isNew ? 12 : undefined} maxlength={isNew ? 72 : 256} required aria-describedby={isNew ? `${name}-requirements` : undefined} />
  <button type="button" data-password-toggle aria-controls={name} aria-label={`Mostrar ${label.toLowerCase()}`} title={`Mostrar ${label.toLowerCase()}`} aria-pressed="false">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {Eye.map(([Tag, attrs]) => <Tag {...attrs} />)}
    </svg>
  </button>
</div>
{isNew && <small id={`${name}-requirements`}>Mínimo 12 caracteres; máximo 72 bytes (los símbolos pueden ocupar más de uno).</small>}
<script>
  function bindPasswords() {
    document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach(button => {
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const input = document.getElementById(button.getAttribute('aria-controls') ?? '') as HTMLInputElement | null;
        if (!input) return;
        const visible = input.type === 'password';
        input.type = visible ? 'text' : 'password';
        button.setAttribute('aria-pressed', String(visible));
        button.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
        button.title = visible ? 'Ocultar contraseña' : 'Mostrar contraseña';
      });
    });
  }
  bindPasswords();
  document.addEventListener('astro:page-load', bindPasswords);
</script>
<style>
  .password-label { font-weight:700; }
  .password-field { display:flex; align-items:center; border:1px solid var(--line); border-radius:4px; min-width:0; }
  .password-field input { width:100%; min-width:0; min-height:44px; padding:0.75rem; border:0; background:transparent; font:inherit; color:inherit; }
  .password-field button { flex:0 0 44px; height:44px; display:grid; place-items:center; background:transparent; border:0; color:inherit; cursor:pointer; }
  .password-field:focus-within { outline:2px solid var(--color-red-accent); outline-offset:2px; }
</style>
