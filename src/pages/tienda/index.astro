---
import Layout from "../../layouts/Layout.astro";
import StoreStock from "../../components/commerce/StoreStock.astro";
import { PRODUCTS } from "../../config/products";
import { SHIRT_PRICE_COPY } from "../../config/commerce";

const shirt = PRODUCTS["camiseta-imperial"];
const shirtPrice = new Intl.NumberFormat("es-ES", {
  style: "currency",
  currency: shirt.currency.toUpperCase(),
}).format(shirt.expectedUnitAmount / 100);
---

<Layout
  footerVariant="dark"
  title="Tienda editorial y productos históricos | Imperio Español"
  description="Lanzamiento 1: Camiseta Imperial de Imperio Español."
>
  <main class="storefront">
    <StoreStock />
    <section class="store-catalog" id="catalogo">
      <header class="store-header">
        <span class="store-mark-spacer" aria-hidden="true"></span>

        <nav class="store-nav" aria-label="Navegacion de la tienda">
          <a href="#mercancias">Mercancias</a>
        </nav>

        <a class="store-account" href="/cuenta">Cuenta</a>
      </header>

      <div class="catalog-heading">
        <p>CASA DE MERCADERIAS</p>
        <h1>TIENDA</h1>
      </div>

      <div class="product-grid" id="mercancias">
        <article
          class="product-card product-card--shirt"
          data-shirt-card
          id="camiseta"
        >
          <div class="product-meta">
            <strong>LANZAMIENTO 1 CAMISETA IMPERIAL</strong>
          </div>
          <div
            class="product-visual product-visual--shirt"
            role="button"
            tabindex="0"
            aria-haspopup="dialog"
            aria-controls="camiseta-imperial-detalle"
            aria-label="Ampliar Camiseta Imperial"
            data-shirt-detail-open
          >
            <div class="product-shirt-placeholder" aria-hidden="true">
              <img
                src="/images/logo-redv2-480.webp"
                alt=""
                width="480"
                height="371"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="product-shirt-scene" aria-hidden="true">
              <div class="product-shirt-scene__frame">
                <img
                  class="product-shirt-scene__start"
                  src="/images/camiseta-escaparate-start.webp"
                  alt=""
                  width="600"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
                <img
                  class="product-shirt-scene__gate"
                  src="/images/verja.webp"
                  alt=""
                  width="600"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
                <img
                  class="product-shirt-scene__facade"
                  src="/images/escaparate.webp"
                  alt=""
                  width="600"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              </div>
              <div class="product-shirt-final" data-shirt-gallery>
                <img
                  class="product-shirt-final__image product-shirt-final__image--front"
                  src="/images/museo-camiseta-front.webp"
                  alt="Camiseta Imperial vista por delante"
                  width="1400"
                  height="1150"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
                <img
                  class="product-shirt-final__image product-shirt-final__image--back"
                  src="/images/museo-camiseta-back.webp"
                  alt="Camiseta Imperial vista por detras"
                  width="1400"
                  height="1150"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
                <button
                  class="product-shirt-gallery-next"
                  type="button"
                  aria-label="Mostrar parte trasera de la camiseta"
                  aria-pressed="false"
                  data-shirt-gallery-next
                >
                  <span aria-hidden="true">&#9654;</span>
                </button>
              </div>
            </div>
          </div>
          <form class="product-purchase" action="/reservas" method="get">
            <p class="product-price">{shirtPrice}</p>
            <label class="size-field">
              <span>Talla</span>
              <select data-shirt-size name="size">
                {shirt.variantDetails.map((variant) => (
                  <option value={variant.size} selected={variant.size === "M"}>
                    {variant.size}
                  </option>
                ))}
              </select>
            </label>
            <button
              class="store-button store-button--light"
              data-reservation-cta
              type="submit"
            >
              {"RESERVAR \u2014 0 \u20ac"}
            </button>
            <p class="product-legal-status">{SHIRT_PRICE_COPY}</p>
            <p class="product-legal-status" data-reservation-stock role="status" aria-live="polite">Consultando disponibilidad...</p>
            <a href="/reservas" data-waitlist-link hidden>APUNTARME A LA LISTA DE ESPERA</a>
            <p class="product-legal-status">100 % poliéster. {shirt.fabricWeightGsm} g/m².</p>
            <p class="product-legal-status">Reserva ahora · No pagaras nada todavia.</p>
          </form>
        </article>
      </div>

    </section>

    <section
      class="shirt-story"
      aria-labelledby="shirt-story-title"
      data-home-mark-surface="red"
    >
      <h2 id="shirt-story-title">DETRÁS DEL DISEÑO</h2>

      <div class="shirt-story__copy">
        <p>
          La Camiseta Imperial convierte una prenda cotidiana en una pieza de
          divulgación. Cada símbolo abre una puerta a los territorios, personajes
          y expediciones que dieron forma a nuestra historia.
        </p>
        <p>
          La cruz de Borgoña, la estrella, el escudo y el lema Non Sufficit Orbis
          conviven con la nave como un relato visual. El diseño une identidad,
          memoria y vocación de descubrimiento.
        </p>
        <p>
          Esta composición muestra el origen y el significado de cada elemento.
          Una lectura pensada para entender la camiseta antes de vestirla y para
          reconocer los detalles que la hacen única.
        </p>
      </div>

      <figure class="shirt-story__image">
        <div class="shirt-story__canvas">
          <picture class="shirt-story__base-picture">
            <source type="image/avif" srcset="/images/explicacion-camiseta.avif" />
            <img
              class="shirt-story__base-image"
              src="/images/explicacion-camiseta.webp"
              alt="Explicación visual de los símbolos y elementos históricos de la Camiseta Imperial"
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
          </picture>

          <div
            class="shirt-story__annotations"
            role="group"
            aria-label="Detalles ampliables de la camiseta"
          >
            <button
              class="shirt-story__annotation shirt-story__annotation--wide"
              type="button"
              aria-label="Ampliar explicación del barco"
              style="--annotation-left:30.625%;--annotation-top:9.074%;--annotation-width:35.313%;--annotation-height:28.241%;"
              data-story-annotation
            >
              <span class="shirt-story__annotation-inner" aria-hidden="true">
                <strong class="shirt-story__annotation-title" data-type-copy data-type-speed="34" data-type-source="BARCO"></strong>
                <span class="shirt-story__annotation-rule"></span>
                <span class="shirt-story__annotation-columns">
                  <span data-type-copy data-type-source="La expedición de Cristóbal Colón partió de Palos de la Frontera en 1492 con la nao Santa María y las carabelas Pinta y Niña.&#10;&#10;La Santa María fue la nave capitana. Encalló en La Española el 25 de diciembre de 1492 y con sus restos se levantó el Fuerte de la Navidad. La Pinta destacó por su velocidad y desde ella Rodrigo de Triana avistó tierra. La Niña, más pequeña y maniobrable, se convirtió después en la nave de regreso de Colón."></span>
                  <span data-type-copy data-type-source="La bandera pintada en las velas era la de la Orden de Cristo, la institución militar y religiosa en la que se transformó la Orden del Temple en Portugal tras su disolución en el siglo XIV.&#10;&#10;Su uso en el viaje de 1492 legitimaba la expedición bajo el espíritu de expansión de la fe católica, autorizado por los Reyes Católicos. Los barcos portaban también banderas blancas con las letras coronadas «F» de Fernando e «Y» de Isabel, con una cruz entre ambas como símbolo de los Reyes Católicos."></span>
                </span>
              </span>
            </button>
            <button
              class="shirt-story__annotation shirt-story__annotation--long-title"
              type="button"
              aria-label="Ampliar explicación de la Cruz de Borgoña"
              style="--annotation-left:15.26%;--annotation-top:41.296%;--annotation-width:10.99%;--annotation-height:38.333%;"
              data-story-annotation
            >
              <span class="shirt-story__annotation-inner" aria-hidden="true">
                <strong class="shirt-story__annotation-title" data-type-copy data-type-speed="30" data-type-source="CRUZ O ASPA DE BORGOÑA"></strong>
                <span class="shirt-story__annotation-rule"></span>
                <span data-type-copy data-type-source="En la parte superior izquierda se encuentra nuestro logo con la cruz de Borgoña roja, o aspa de Borgoña, que representa la cruz de San Andrés donde los troncos que forman dicha cruz aparecen con sus nudos en los lugares donde se cortaron las ramas.&#10;&#10;Originada como enseña del ducado de Borgoña, la Casa de Habsburgo la adoptó posteriormente como un emblema personal. Con la llegada de esta dinastía a la Corona de Castilla en 1506, el aspa de Borgoña se transformó en uno de los estandartes más emblemáticos del Imperio Español. Pese a perder protagonismo con los siglos, jamás fue abolida oficialmente.&#10;&#10;Hoy en día, su legado perdura en la heráldica de múltiples organismos e instituciones de Europa y América."></span>
              </span>
            </button>
            <button
              class="shirt-story__annotation"
              type="button"
              aria-label="Ampliar explicación de la estrella"
              style="--annotation-left:29.583%;--annotation-top:59.444%;--annotation-width:10.104%;--annotation-height:28.056%;"
              data-story-annotation
            >
              <span class="shirt-story__annotation-inner" aria-hidden="true">
                <strong class="shirt-story__annotation-title" data-type-copy data-type-speed="32" data-type-source="ESTRELLA"></strong>
                <span class="shirt-story__annotation-rule"></span>
                <span data-type-copy data-type-source="En la zona superior central de la camiseta encontramos una estrella con el número doce, representando los mundiales conseguidos por territorios pertenecientes al territorio hispánico en dicho momento. Al ser el escudo de Felipe II y su rey fue conocido en latín Ibérica durante su reinado, tenemos que contar con la actual Brasil, por lo que el recuento quedaría de la siguiente forma: España 2, Uruguay 2, Argentina 3 y Brasil 5."></span>
              </span>
            </button>
            <button
              class="shirt-story__annotation"
              type="button"
              aria-label="Ampliar explicación de la frase Non Sufficit Orbis"
              style="--annotation-left:57.083%;--annotation-top:59.444%;--annotation-width:9.323%;--annotation-height:28.426%;"
              data-story-annotation
            >
              <span class="shirt-story__annotation-inner" aria-hidden="true">
                <strong class="shirt-story__annotation-title" data-type-copy data-type-speed="32" data-type-source="FRASE"></strong>
                <span class="shirt-story__annotation-rule"></span>
                <span data-type-copy data-type-source="El famoso lema del monarca hispano Non Sufficit Orbis, cuyo significado es «El mundo no es suficiente». Al parecer, esta frase surge cuando Felipe II se convierte en Rey de Portugal en el año 1580.&#10;&#10;Con Felipe II, el Imperio Español llegó a ser la primera potencia de Europa y alcanzó su gran apogeo, logrando por primera vez en la historia integrar territorios de todos los continentes habitados para aquella época."></span>
              </span>
            </button>
            <button
              class="shirt-story__annotation"
              type="button"
              aria-label="Ampliar explicación del escudo"
              style="--annotation-left:70.677%;--annotation-top:38.519%;--annotation-width:10.573%;--annotation-height:36.481%;"
              data-story-annotation
            >
              <span class="shirt-story__annotation-inner" aria-hidden="true">
                <strong class="shirt-story__annotation-title" data-type-copy data-type-speed="32" data-type-source="ESCUDO"></strong>
                <span class="shirt-story__annotation-rule"></span>
                <span data-type-copy data-type-source="El escudo pertenece al Rey de España, Felipe II, por lo que dentro del mismo se encuentran representados los territorios que pertenecían al Imperio Español cuando gobernaba este monarca: Austria, Borgoña, Aragón, Borgoña moderno, Brabante, Baviera, Tirol, Anjou, Flandes, Habsburgo, Cerdeña, Con, Cerdeña-Habsburgo, Cerdeña el de armas de Portugal, ya que fue proclamado Rey de Portugal el 12 de septiembre de 1580 con el nombre de Felipe I de Portugal. Esta unión dinástica duraría sesenta años.&#10;&#10;Alrededor del escudo se encuentra el Collar de la Orden del Toisón de Oro, una de las órdenes de caballería más prestigiosas y antiguas de Europa. Esta muy ligada a la dinastía de los Habsburgo, y a las coronas de Austria y España."></span>
              </span>
            </button>
          </div>
        </div>
      </figure>
    </section>
  </main>

  <dialog
    class="shirt-detail"
    id="camiseta-imperial-detalle"
    aria-labelledby="camiseta-imperial-detalle-titulo"
    data-shirt-detail
  >
    <div class="shirt-detail__shell">
      <header class="shirt-detail__header">
        <div>
          <h2 id="camiseta-imperial-detalle-titulo">LANZAMIENTO 1 CAMISETA IMPERIAL</h2>
        </div>

        <div class="shirt-detail__tools" aria-label="Controles de imagen">
          <button
            type="button"
            aria-label="Alejar imagen"
            title="Alejar imagen"
            data-shirt-zoom-out
          >
            <i data-lucide="zoom-out" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            aria-label="Ampliar imagen"
            title="Ampliar imagen"
            data-shirt-zoom-in
          >
            <i data-lucide="zoom-in" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            aria-label="Restablecer zoom"
            title="Restablecer zoom"
            data-shirt-zoom-reset
          >
            <i data-lucide="rotate-ccw" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            aria-label="Cerrar vista ampliada"
            title="Cerrar"
            data-shirt-detail-close
          >
            <i data-lucide="x" aria-hidden="true"></i>
          </button>
        </div>
      </header>

      <div
        class="shirt-detail__stage"
        tabindex="0"
        role="group"
        aria-label="Visor ampliado de la camiseta"
      >
        <div class="shirt-detail__media" data-shirt-detail-media>
          <img
            class="shirt-detail__image shirt-detail__image--front"
            src="/images/camiseta-imperio-frontal.webp"
            alt="Camiseta Imperial vista por delante"
            width="944"
            height="1181"
            loading="lazy"
            decoding="async"
          />
          <img
            class="shirt-detail__image shirt-detail__image--back"
            src="/images/camiseta-imperio-atras.webp"
            alt="Camiseta Imperial vista por detras"
            width="1077"
            height="1211"
            loading="lazy"
            decoding="async"
          />
        </div>

        <button
          class="shirt-detail__arrow"
          type="button"
          aria-label="Mostrar parte trasera de la camiseta"
          aria-pressed="false"
          data-shirt-detail-toggle
        >
          <i data-lucide="chevron-right" aria-hidden="true"></i>
        </button>
      </div>

      <footer class="shirt-detail__footer">
        <span data-shirt-detail-side>Frontal</span>
        <span data-shirt-zoom-value>100%</span>
      </footer>
    </div>
  </dialog>
</Layout>

<script>
  import {
    ChevronRight,
    RotateCcw,
    X,
    ZoomIn,
    ZoomOut,
    createIcons,
  } from "lucide";

  createIcons({
    icons: {
      ChevronRight,
      RotateCcw,
      X,
      ZoomIn,
      ZoomOut,
    },
  });

  type AnnotationTypingState = {
    run: number;
    status: "idle" | "typing" | "complete";
  };

  const annotationStates = new WeakMap<HTMLElement, AnnotationTypingState>();
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const waitForCharacter = (delay: number) =>
    new Promise<void>((resolve) => window.setTimeout(resolve, delay));

  function annotationTextOverflows(annotation: HTMLElement) {
    const inner = annotation.querySelector<HTMLElement>(".shirt-story__annotation-inner");
    const textTargets = annotation.querySelectorAll<HTMLElement>("[data-type-copy]");
    if (!inner) return false;

    if (inner.scrollHeight > inner.clientHeight + 1) return true;

    return [...textTargets].some(
      (target) =>
        target.scrollHeight > target.clientHeight + 1 ||
        target.scrollWidth > target.clientWidth + 1
    );
  }

  function fitAnnotationText(annotation: HTMLElement) {
    const targets = [...annotation.querySelectorAll<HTMLElement>("[data-type-copy]")];
    const currentText = targets.map((target) => target.textContent ?? "");

    annotation.classList.add("is-measuring");
    targets.forEach((target) => {
      target.textContent = target.dataset.typeSource ?? "";
    });

    let scale = 0.96;
    annotation.style.setProperty("--annotation-copy-scale", String(scale));

    while (annotationTextOverflows(annotation) && scale > 0.55) {
      scale = Math.max(0.55, scale - 0.025);
      annotation.style.setProperty("--annotation-copy-scale", String(scale));
    }

    targets.forEach((target, index) => {
      target.textContent = currentText[index];
    });
    annotation.classList.remove("is-measuring");
  }

  function resetAnnotation(annotation: HTMLElement) {
    const state = annotationStates.get(annotation);
    if (!state) return;

    state.run += 1;
    state.status = "idle";
    annotation.classList.remove("is-typing", "is-typed");
    annotation.querySelectorAll<HTMLElement>("[data-type-copy]").forEach((target) => {
      target.textContent = "";
      target.classList.remove("is-typing-target");
    });
  }

  function typeAnnotation(annotation: HTMLElement) {
    const state = annotationStates.get(annotation);
    if (!state || state.status !== "idle") return;

    state.status = "typing";
    const run = ++state.run;
    const targets = [...annotation.querySelectorAll<HTMLElement>("[data-type-copy]")];
    annotation.classList.add("is-typing");

    if (reducedMotion.matches) {
      targets.forEach((target) => {
        target.textContent = target.dataset.typeSource ?? "";
      });
      state.status = "complete";
      annotation.classList.replace("is-typing", "is-typed");
      return;
    }

    void (async () => {
      for (const target of targets) {
        const source = target.dataset.typeSource ?? "";
        const speed = Number(target.dataset.typeSpeed ?? 4);
        target.classList.add("is-typing-target");

        for (const character of source) {
          if (state.run !== run) return;
          target.textContent += character;
          await waitForCharacter(character === " " ? Math.max(1, speed / 2) : speed);
        }

        target.classList.remove("is-typing-target");
      }

      if (state.run !== run) return;
      state.status = "complete";
      annotation.classList.replace("is-typing", "is-typed");
    })();
  }

  const annotationObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting && entry.target instanceof HTMLElement) {
        resetAnnotation(entry.target);
      }
    });
  });

  const storyAnnotations = [
    ...document.querySelectorAll<HTMLElement>("[data-story-annotation]"),
  ];

  storyAnnotations.forEach((annotation) => {
    annotationStates.set(annotation, { run: 0, status: "idle" });
    annotation.addEventListener("pointerenter", () => typeAnnotation(annotation));
    annotation.addEventListener("focus", () => typeAnnotation(annotation));
    annotationObserver.observe(annotation);
  });

  requestAnimationFrame(() => {
    storyAnnotations.forEach(fitAnnotationText);
  });

  let annotationFitFrame = 0;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(annotationFitFrame);
    annotationFitFrame = requestAnimationFrame(() => {
      storyAnnotations.forEach(fitAnnotationText);
    });
  });

  document.querySelectorAll("[data-shirt-gallery]").forEach((gallery) => {
    const nextButton = gallery.querySelector("[data-shirt-gallery-next]");
    if (!(gallery instanceof HTMLElement) || !(nextButton instanceof HTMLButtonElement)) {
      return;
    }

    nextButton.addEventListener("click", () => {
      const showingBack = gallery.classList.toggle("is-showing-back");
      nextButton.setAttribute("aria-pressed", String(showingBack));
      nextButton.setAttribute(
        "aria-label",
        showingBack
          ? "Mostrar parte delantera de la camiseta"
          : "Mostrar parte trasera de la camiseta"
      );
    });
  });

  const shirtCard = document.querySelector("[data-shirt-card]");
  const shirtDetailOpen = document.querySelector("[data-shirt-detail-open]");
  const shirtDetail = document.querySelector("[data-shirt-detail]");
  const shirtDetailStage = shirtDetail?.querySelector(".shirt-detail__stage");
  const shirtDetailMedia = document.querySelector("[data-shirt-detail-media]");
  const shirtDetailToggle = document.querySelector("[data-shirt-detail-toggle]");
  const shirtDetailClose = document.querySelector("[data-shirt-detail-close]");
  const shirtZoomIn = document.querySelector("[data-shirt-zoom-in]");
  const shirtZoomOut = document.querySelector("[data-shirt-zoom-out]");
  const shirtZoomReset = document.querySelector("[data-shirt-zoom-reset]");
  const shirtDetailSide = document.querySelector("[data-shirt-detail-side]");
  const shirtZoomValue = document.querySelector("[data-shirt-zoom-value]");
  const shirtMinZoom = 1;
  const shirtMaxZoom = 3;
  const shirtButtonZoomStep = 0.5;
  const shirtWheelZoomStep = 0.25;
  const shirtPointers = new Map<number, { x: number; y: number }>();
  let shirtZoom = shirtMinZoom;
  let shirtPanX = 0;
  let shirtPanY = 0;
  let shirtDetailShowingBack = false;
  let shirtDragPointerId: number | null = null;
  let shirtDragX = 0;
  let shirtDragY = 0;
  let shirtPinchDistance = 0;

  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }

  function getShirtPanBounds(zoom: number = shirtZoom) {
    if (!(shirtDetailStage instanceof HTMLElement)) return { x: 0, y: 0 };
    const stageRect = shirtDetailStage.getBoundingClientRect();
    return {
      x: Math.max(0, (stageRect.width * (zoom - 1)) / 2),
      y: Math.max(0, (stageRect.height * (zoom - 1)) / 2),
    };
  }

  function clampShirtPan() {
    const bounds = getShirtPanBounds();
    shirtPanX = clamp(shirtPanX, -bounds.x, bounds.x);
    shirtPanY = clamp(shirtPanY, -bounds.y, bounds.y);
  }

  function updateShirtDetail() {
    if (!(shirtDetail instanceof HTMLDialogElement)) return;

    const isZoomed = shirtZoom > shirtMinZoom + 0.001;
    shirtDetail.classList.toggle("is-showing-back", shirtDetailShowingBack);
    shirtDetail.classList.toggle("is-zoomed", isZoomed);

    if (shirtDetailMedia instanceof HTMLElement) {
      shirtDetailMedia.style.setProperty("--shirt-main-scale", String(shirtZoom));
      shirtDetailMedia.style.setProperty("--shirt-pan-x", `${shirtPanX}px`);
      shirtDetailMedia.style.setProperty("--shirt-pan-y", `${shirtPanY}px`);
    }

    if (shirtDetailToggle instanceof HTMLButtonElement) {
      shirtDetailToggle.setAttribute("aria-pressed", String(shirtDetailShowingBack));
      shirtDetailToggle.setAttribute(
        "aria-label",
        shirtDetailShowingBack
          ? "Mostrar parte delantera de la camiseta"
          : "Mostrar parte trasera de la camiseta"
      );
    }

    if (shirtZoomOut instanceof HTMLButtonElement) {
      shirtZoomOut.disabled = !isZoomed;
    }

    if (shirtZoomIn instanceof HTMLButtonElement) {
      shirtZoomIn.disabled = shirtZoom >= shirtMaxZoom - 0.001;
    }

    if (shirtZoomReset instanceof HTMLButtonElement) {
      shirtZoomReset.disabled = !isZoomed;
    }

    if (shirtDetailSide) {
      shirtDetailSide.textContent = shirtDetailShowingBack ? "Trasera" : "Frontal";
    }

    if (shirtZoomValue) {
      shirtZoomValue.textContent = `${Math.round(shirtZoom * 100)}%`;
    }
  }

  function setShirtZoom(
    nextZoom: number,
    focalClientX?: number,
    focalClientY?: number
  ) {
    const previousZoom = shirtZoom;
    const normalizedZoom = clamp(nextZoom, shirtMinZoom, shirtMaxZoom);
    if (Math.abs(normalizedZoom - previousZoom) < 0.001) return;

    if (
      typeof focalClientX === "number" &&
      typeof focalClientY === "number" &&
      shirtDetailStage instanceof HTMLElement
    ) {
      const stageRect = shirtDetailStage.getBoundingClientRect();
      const focalX = focalClientX - (stageRect.left + stageRect.width / 2);
      const focalY = focalClientY - (stageRect.top + stageRect.height / 2);
      const contentX = (focalX - shirtPanX) / previousZoom;
      const contentY = (focalY - shirtPanY) / previousZoom;
      shirtPanX = focalX - contentX * normalizedZoom;
      shirtPanY = focalY - contentY * normalizedZoom;
    }

    shirtZoom = normalizedZoom;
    if (shirtZoom <= shirtMinZoom + 0.001) {
      shirtPanX = 0;
      shirtPanY = 0;
    } else {
      clampShirtPan();
    }
    updateShirtDetail();
  }

  function resetShirtView() {
    shirtZoom = shirtMinZoom;
    shirtPanX = 0;
    shirtPanY = 0;
    updateShirtDetail();
  }

  function getShirtPinchMetrics() {
    const points = Array.from(shirtPointers.values());
    if (points.length < 2) return null;
    const [first, second] = points;
    return {
      distance: Math.hypot(second.x - first.x, second.y - first.y),
      x: (first.x + second.x) / 2,
      y: (first.y + second.y) / 2,
    };
  }

  function stopShirtDragging(pointerId: number) {
    if (shirtDragPointerId === pointerId) shirtDragPointerId = null;
    shirtPointers.delete(pointerId);
    if (shirtPointers.size < 2) shirtPinchDistance = 0;

    if (shirtPointers.size === 1 && shirtZoom > shirtMinZoom) {
      const remaining = shirtPointers.entries().next().value;
      if (remaining) {
        const [remainingId, remainingPoint] = remaining;
        shirtDragPointerId = remainingId;
        shirtDragX = remainingPoint.x;
        shirtDragY = remainingPoint.y;
      }
    }

    if (shirtDragPointerId === null && shirtPointers.size < 2) {
      shirtDetail?.classList.remove("is-dragging");
    }
  }

  function openShirtDetail() {
    if (!(shirtDetail instanceof HTMLDialogElement) || shirtDetail.open) return;

    const cardGallery = shirtCard?.querySelector("[data-shirt-gallery]");
    shirtDetailShowingBack =
      cardGallery instanceof HTMLElement &&
      cardGallery.classList.contains("is-showing-back");
    shirtZoom = shirtMinZoom;
    shirtPanX = 0;
    shirtPanY = 0;
    updateShirtDetail();
    shirtDetail.showModal();
    document.documentElement.classList.add("has-shirt-detail-open");
    requestAnimationFrame(() => {
      if (shirtDetailStage instanceof HTMLElement) {
        shirtDetailStage.focus({ preventScroll: true });
      }
    });
  }

  function closeShirtDetail() {
    if (!(shirtDetail instanceof HTMLDialogElement) || !shirtDetail.open) return;
    shirtDetail.close();
  }

  shirtDetailOpen?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest("button, a, input, select, label")) return;
    openShirtDetail();
  });

  shirtDetailOpen?.addEventListener("keydown", (event) => {
    if (!(event instanceof KeyboardEvent)) return;
    if (event.key !== "Enter" && event.key !== " ") return;
    event.preventDefault();
    openShirtDetail();
  });

  shirtDetailToggle?.addEventListener("click", () => {
    shirtDetailShowingBack = !shirtDetailShowingBack;
    resetShirtView();
  });

  shirtZoomIn?.addEventListener("click", () => {
    setShirtZoom(shirtZoom + shirtButtonZoomStep);
  });

  shirtZoomOut?.addEventListener("click", () => {
    setShirtZoom(shirtZoom - shirtButtonZoomStep);
  });

  shirtZoomReset?.addEventListener("click", resetShirtView);

  shirtDetailStage?.addEventListener("pointerdown", (event) => {
    if (!(event instanceof PointerEvent) || !(shirtDetailStage instanceof HTMLElement)) return;
    if (event.target instanceof Element && event.target.closest("button")) return;
    if (event.pointerType === "mouse" && event.button !== 0) return;

    if (event.pointerType === "touch") {
      shirtPointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      shirtDetailStage.setPointerCapture(event.pointerId);
      const pinch = getShirtPinchMetrics();
      if (pinch) {
        shirtPinchDistance = pinch.distance;
        shirtDragPointerId = null;
        shirtDetail?.classList.add("is-dragging");
        event.preventDefault();
        return;
      }
    }

    if (shirtZoom <= shirtMinZoom + 0.001) return;
    shirtDragPointerId = event.pointerId;
    shirtDragX = event.clientX;
    shirtDragY = event.clientY;
    shirtDetailStage.setPointerCapture(event.pointerId);
    shirtDetail?.classList.add("is-dragging");
    event.preventDefault();
  });

  shirtDetailStage?.addEventListener("pointermove", (event) => {
    if (!(event instanceof PointerEvent)) return;

    if (shirtPointers.has(event.pointerId)) {
      shirtPointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      const pinch = getShirtPinchMetrics();
      if (pinch) {
        if (shirtPinchDistance > 0) {
          setShirtZoom(
            shirtZoom * (pinch.distance / shirtPinchDistance),
            pinch.x,
            pinch.y
          );
        }
        shirtPinchDistance = pinch.distance;
        event.preventDefault();
        return;
      }
    }

    if (shirtDragPointerId !== event.pointerId || shirtZoom <= shirtMinZoom) return;
    shirtPanX += event.clientX - shirtDragX;
    shirtPanY += event.clientY - shirtDragY;
    shirtDragX = event.clientX;
    shirtDragY = event.clientY;
    clampShirtPan();
    updateShirtDetail();
    event.preventDefault();
  });

  shirtDetailStage?.addEventListener("pointerup", (event) => {
    if (event instanceof PointerEvent) stopShirtDragging(event.pointerId);
  });

  shirtDetailStage?.addEventListener("pointercancel", (event) => {
    if (event instanceof PointerEvent) stopShirtDragging(event.pointerId);
  });

  shirtDetailStage?.addEventListener(
    "wheel",
    (event) => {
      if (!(event instanceof WheelEvent)) return;

      event.preventDefault();
      const direction = event.deltaY < 0 ? 1 : -1;
      setShirtZoom(
        shirtZoom + direction * shirtWheelZoomStep,
        event.clientX,
        event.clientY
      );
    },
    { passive: false }
  );

  shirtDetailStage?.addEventListener("dblclick", (event) => {
    if (!(event instanceof MouseEvent)) return;
    if (shirtZoom > shirtMinZoom) {
      resetShirtView();
    } else {
      setShirtZoom(2, event.clientX, event.clientY);
    }
  });

  shirtDetailStage?.addEventListener("keydown", (event) => {
    if (!(event instanceof KeyboardEvent)) return;
    const panStep = 64;

    if (event.key === "+" || event.key === "=") {
      event.preventDefault();
      setShirtZoom(shirtZoom + shirtButtonZoomStep);
      return;
    }
    if (event.key === "-") {
      event.preventDefault();
      setShirtZoom(shirtZoom - shirtButtonZoomStep);
      return;
    }
    if (event.key === "0") {
      event.preventDefault();
      resetShirtView();
      return;
    }
    if (shirtZoom <= shirtMinZoom) return;

    const panByKey = {
      ArrowLeft: [panStep, 0],
      ArrowRight: [-panStep, 0],
      ArrowUp: [0, panStep],
      ArrowDown: [0, -panStep],
    }[event.key];
    if (!panByKey) return;

    event.preventDefault();
    shirtPanX += panByKey[0];
    shirtPanY += panByKey[1];
    clampShirtPan();
    updateShirtDetail();
  });

  window.addEventListener("resize", () => {
    if (shirtDetail instanceof HTMLDialogElement && shirtDetail.open) {
      clampShirtPan();
      updateShirtDetail();
    }
  });

  shirtDetailClose?.addEventListener("click", closeShirtDetail);

  shirtDetail?.addEventListener("click", (event) => {
    if (event.target === shirtDetail) closeShirtDetail();
  });

  shirtDetail?.addEventListener("close", () => {
    document.documentElement.classList.remove("has-shirt-detail-open");
    shirtPointers.clear();
    shirtDragPointerId = null;
    shirtPinchDistance = 0;
    shirtDetail.classList.remove("is-dragging");
  });
</script>

