<script>
  import { formatMoney } from "../../config/commerce";
  function setupStoreStock() {
    for (const form of document.querySelectorAll<HTMLFormElement>(".product-purchase")) bindStock(form);
  }
  function bindStock(form: HTMLFormElement) {
    if (form.dataset.stockBound) return;
    form.dataset.stockBound = "true";
    const sizes = [...form.querySelectorAll<HTMLInputElement>("[data-shirt-size]")];
    const quantity = form.querySelector<HTMLInputElement>("[name=quantity]");
    const button = form.querySelector<HTMLButtonElement>("[data-reservation-cta]");
    const status = form.querySelector<HTMLElement>("[data-reservation-stock]");
    const waiting = form.querySelector<HTMLAnchorElement>("[data-waitlist-link]");
    const card = form.closest("[data-shirt-product]");
    const price = card?.querySelector<HTMLElement>("[data-shirt-price-value]");
    const campaign = card?.querySelector<HTMLElement>("[data-shirt-bf]");
    const cartButton = form.querySelector<HTMLButtonElement>("[data-cart-add]");
    if (!sizes.length || !quantity || !button || !status || !waiting) return;
    let stopped = false;
    type Inventory = {
      variants: { name: string; available: boolean }[];
      salesEnabled: boolean;
      unitPrice: number;
      blackFriday?: boolean;
      reservationMode: boolean;
      campaign?: { max_reservation_quantity?: number | null };
    };
    let inventory: Inventory | undefined;
    const update = () => {
      if (!inventory) return;
      if (price && Number.isSafeInteger(inventory.unitPrice) && inventory.unitPrice > 0) price.textContent = formatMoney(inventory.unitPrice);
      if (campaign) campaign.hidden = !inventory.blackFriday;
      const selected = sizes.find(size => size.checked);
      if (!selected) return;
      const variant = inventory.variants.find(variant => variant.name === selected.value);
      const exhausted = !variant?.available;
      for (const size of sizes) {
        const available = inventory.variants.find(variant => variant.name === size.value)?.available;
        size.closest("label")?.toggleAttribute("data-unavailable", !available);
      }
      const max = inventory.campaign?.max_reservation_quantity;
      if (typeof max === "number" && Number.isSafeInteger(max) && max > 0) {
        quantity.max = String(max);
      } else {
        quantity.removeAttribute("max");
      }
      button.disabled = exhausted;
      if (cartButton) cartButton.disabled = exhausted || (!inventory.salesEnabled && !inventory.reservationMode);
      waiting.hidden = !exhausted;
      waiting.href = `/reservas?size=${encodeURIComponent(selected.value)}`;
      status.textContent = exhausted ? "Talla agotada" : inventory.salesEnabled ? "Disponible" : inventory.reservationMode ? "Pre-reserva gratuita disponible" : "Compra no disponible por el momento";
    };
    const refresh = async () => {
      try {
        const response = await fetch("/api/reservations/inventory", { cache: "no-store" });
        if (!response.ok) throw new Error();
        if (stopped) return;
        inventory = await response.json();
        if (!stopped) update();
      } catch {
        if (!stopped && !inventory) status.textContent = "Consulta la disponibilidad al continuar.";
      }
    };
    sizes.forEach(size => size.addEventListener("change", update));
    void refresh();
    const timer = setInterval(() => { if (!document.hidden) void refresh(); }, 10000);
    document.addEventListener("astro:before-swap", () => { stopped = true; clearInterval(timer); }, { once: true });
  }
  setupStoreStock();
  document.addEventListener("astro:page-load", setupStoreStock);
</script>
