---
import PageShell from "../../layouts/PageShell.astro";
import ReservationManager from "../../components/commerce/ReservationManager";
import { reservationMode } from "../../lib/reservations";
import "../../styles/commerce.css";
export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
---
<PageShell heading={reservationMode() ? "Tu reserva" : "Revisa tu compra"} title={`${reservationMode() ? "Tu reserva" : "Revisa tu compra"} | Imperio Español`} noindex showCookieConsent={false}><ReservationManager client:load/></PageShell>
