---
import PageShell from "../../layouts/PageShell.astro";
export const prerender=false;
Astro.response.headers.set("Cache-Control","private, no-store");
Astro.response.headers.set("Referrer-Policy","no-referrer");
---
<PageShell title="Confirmar comunicaciones" heading="Tus historias por correo" noindex narrow>
  <p>Confirma que quieres recibir historias, novedades y ofertas de Imperio Español. Puedes darte de baja cuando quieras.</p>
  <button class="btn btn-primary" id="confirm-marketing" type="button">Confirmar mi suscripción</button>
  <p role="status" aria-live="polite" id="confirmation-status"></p>
</PageShell>
<script>
  const credentials=location.hash.slice(1).split(".");history.replaceState(null,"",location.pathname);
  const button=document.querySelector<HTMLButtonElement>("#confirm-marketing")!;
  const status=document.querySelector<HTMLElement>("#confirmation-status")!;
  button.addEventListener("click",async()=>{
    button.disabled=true;
    try{const response=await fetch("/api/marketing/confirm",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:credentials[0],token:credentials[1]})});
      const result=await response.json();if(!response.ok||!result.ok)throw Error();status.textContent="Tu suscripción está confirmada. Gracias por acompañarnos.";
    }catch{status.textContent="El enlace ha caducado, ya se ha utilizado o no está disponible. Puedes gestionar tus comunicaciones desde Mi cuenta.";}
  });
</script>
