---
import { TSHIRT_DISCOUNT_PERCENT, TSHIRT_OFFER_COPY } from "../config/tshirt-offer";
import { reservationMode } from "../lib/reservations";
const reserving = reservationMode();
const excluded = /^\/(?:login|registro|recuperar-contrasena|confirmar-correo|cuenta(?:\/|$)|checkout|reservas(?:\/|$)|reserva(?:\/|$)|compra(?:\/|$)|gracias(?:\/|$)|admin(?:\/|$))/;
const enabled = !excluded.test(Astro.url.pathname) && Astro.url.pathname.replace(/\/$/, "") !== "/instagram";
---

{enabled && (
  <div class="tshirt-lead" data-tshirt-lead hidden>
    <button class="tshirt-lead__backdrop" type="button" data-tshirt-close tabindex="-1" aria-label="Cerrar"></button>
    <section class="tshirt-lead__dialog" role="dialog" aria-modal="true" aria-labelledby="tshirt-lead-title" aria-describedby="tshirt-lead-copy">
      <button class="tshirt-lead__close" type="button" data-tshirt-close aria-label="Cerrar oferta" title="Cerrar">&times;</button>
      <div class="tshirt-lead__media">
        <img src="/images/camiseta-imperio-frontal.webp" alt="Camiseta Imperial de Imperio E" width="1080" height="1080" loading="eager" decoding="async" />
      </div>
      <div class="tshirt-lead__content">
        <span class="tshirt-lead__eyebrow">{TSHIRT_DISCOUNT_PERCENT}% de descuento</span>
        <h2 id="tshirt-lead-title">Una pieza de nuestra historia.</h2>
        <p id="tshirt-lead-copy">{TSHIRT_OFFER_COPY}</p>
        <p>Artículos para suscriptores por 1,99 € al mes o 17,99 € al año. IVA incluido. Renovación automática hasta cancelación.</p>
        <div class="tshirt-lead__actions">
          <a class="btn btn-primary tshirt-lead__submit tshirt-lead__submit--reserve" href="/reservas" data-tshirt-reserve>{reserving ? "Reservar ya" : "Comprar camiseta"}</a>
          <a class="btn tshirt-lead__submit tshirt-lead__submit--discount" href="/suscribirse#arcabucero" data-tshirt-offer>Quiero descuento</a>
        </div>
        <p class="tshirt-lead__fineprint">{reserving ? "La reserva no realiza ningun cobro. Recibiras la invitacion de compra por correo cuando el pago este disponible." : "26,99 EUR de camiseta + 3 EUR de envio por unidad. IVA incluido. Pago seguro en Stripe. Solo Peninsula."} <a href="/legal/terminos">Condiciones de la oferta</a>.</p>
      </div>
    </section>
  </div>
)}

<style>
  .tshirt-lead{position:fixed;inset:0;z-index:12000;display:grid;place-items:center;padding:20px;opacity:0;transition:opacity 280ms ease}
  .tshirt-lead[hidden]{display:none}
  .tshirt-lead[data-open]{opacity:1}
  .tshirt-lead__backdrop{position:absolute;inset:0;width:100%;height:100%;border:0;background:rgb(11 12 12 / 72%);cursor:default}
  .tshirt-lead__dialog{position:relative;display:grid;grid-template-columns:minmax(260px,.85fr) minmax(320px,1.15fr);width:min(900px,100%);max-height:calc(100dvh - 40px);overflow:auto;background:var(--color-white-off);color:#111;border:1px solid rgb(212 175 55 / 55%);box-shadow:0 24px 70px rgb(0 0 0 / 38%);transform:translateY(12px);transition:transform 280ms ease}
  .tshirt-lead[data-open] .tshirt-lead__dialog{transform:translateY(0)}
  .tshirt-lead__close{position:absolute;top:10px;right:10px;z-index:2;width:44px;height:44px;border:0;background:rgb(250 250 250 / 92%);color:#111;font-size:30px;line-height:1;cursor:pointer}
  .tshirt-lead__media{display:grid;place-items:center;min-height:300px;padding:28px;background:#ece9e3;border-right:1px solid var(--line);overflow:hidden}
  .tshirt-lead__media img{display:block;width:100%;height:auto;max-height:500px;object-fit:contain}
  .tshirt-lead__content{position:relative;min-width:0;padding:40px}
  .tshirt-lead__content::before{content:"";position:absolute;top:0;left:40px;width:82px;height:3px;background:var(--color-gold)}
  .tshirt-lead__eyebrow{display:block;margin-bottom:10px;color:var(--color-red-deep);font-size:13px;font-weight:700;text-transform:uppercase}
  .tshirt-lead h2{margin:0 0 12px;font-family:var(--font-serif);font-size:2.5rem;line-height:1.1}
  .tshirt-lead p{line-height:1.55}
  .tshirt-lead__actions{display:grid;gap:10px;margin-top:20px}
  .tshirt-lead__submit{display:flex;align-items:center;justify-content:center;width:100%;margin:0;text-align:center;text-transform:uppercase;white-space:normal}
  .tshirt-lead__submit--reserve{min-height:60px;font-size:1.05rem;font-weight:700}
  .tshirt-lead__submit--discount{min-height:46px;border:1px solid var(--color-red-accent);background:transparent;color:#111;font-weight:700}
  .tshirt-lead__submit--discount:hover{background:rgb(242 56 30 / 8%);transform:translateY(-1px)}
  .tshirt-lead__fineprint{margin:14px 0 0;font-size:12px}
  .tshirt-lead__fineprint a{text-decoration:underline}
  @media(max-width:680px){.tshirt-lead{padding:12px}.tshirt-lead__dialog{grid-template-columns:1fr;grid-template-rows:auto auto;max-height:calc(100dvh - 24px)}.tshirt-lead__media{min-height:150px;height:190px;height:min(190px,26dvh);padding:12px;border-right:0;border-bottom:1px solid var(--line)}.tshirt-lead__media img{width:100%;height:100%;max-height:100%;object-fit:contain}.tshirt-lead__content{padding:22px 20px}.tshirt-lead__content::before{left:20px}.tshirt-lead h2{font-size:1.75rem}.tshirt-lead__content>p{font-size:14px;margin-top:10px;margin-bottom:10px}.tshirt-lead__actions{gap:8px;margin-top:16px}.tshirt-lead__submit--reserve{min-height:56px;font-size:1rem}.tshirt-lead__close{top:6px;right:6px}}
  @media(max-width:680px){.tshirt-lead__media{position:relative}.tshirt-lead__media img{position:absolute;inset:12px;width:calc(100% - 24px);height:calc(100% - 24px);max-height:none}}
  @media(prefers-reduced-motion:reduce){.tshirt-lead,.tshirt-lead__dialog{transition:none}}
</style>

<script>
  const root = document.querySelector('[data-tshirt-lead]');
  if (root instanceof HTMLElement) {
    const storageKey = 'imperio:tshirt-offer-session:v2';
    const legacyStorageKey = 'imperio:arcabucero-offer:v1';
    const closeButtons = root.querySelectorAll('[data-tshirt-close]');
    let previousOverflow = '';
    let lastFocus: Element | null = null;
    let dismissedForSession = false;
    try {
      localStorage.removeItem(legacyStorageKey);
      dismissedForSession = Boolean(sessionStorage.getItem(storageKey));
    } catch {}

    const focusable = (): HTMLElement[] => Array.from(root.querySelectorAll('a[href],button:not([disabled]),input:not([disabled]):not([tabindex="-1"])')).filter((item): item is HTMLElement => item instanceof HTMLElement && item.offsetParent !== null);
    const persist = (state: string) => {
      dismissedForSession = true;
      try { sessionStorage.setItem(storageKey, state); } catch {}
    };
    const close = (state = 'closed') => {
      persist(state);
      root.removeAttribute('data-open');
      window.setTimeout(() => { root.hidden = true; document.body.style.overflow = previousOverflow; if (lastFocus instanceof HTMLElement) lastFocus.focus(); }, window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 280);
    };
    const open = () => {
      lastFocus = document.activeElement;
      previousOverflow = document.body.style.overflow;
      root.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => { root.setAttribute('data-open', ''); (root.querySelector('.tshirt-lead__close') as HTMLElement)?.focus({ preventScroll:true }); });
    };
    closeButtons.forEach((button) => button.addEventListener('click', () => close()));
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { event.preventDefault(); close(); return; }
      if (event.key !== 'Tab') return;
      const items = focusable();
      if (!items.length) return;
      const first = items[0], last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    root.querySelector('[data-tshirt-reserve]')?.addEventListener('click', () => persist('reservation'));
    root.querySelector('[data-tshirt-offer]')?.addEventListener('click', () => persist('discount'));
    const scheduleOpen = (delay: number) => window.setTimeout(() => {
      let dismissed = dismissedForSession;
      try { dismissed = Boolean(sessionStorage.getItem(storageKey)); } catch {}
      if (!dismissed && root.hidden) open();
    }, delay);
    if (!dismissedForSession) {
      const preloader = document.getElementById('preloader');
      if (preloader && !document.body.classList.contains('preloader-done')) {
        window.addEventListener('preloader:done', () => scheduleOpen(350), { once:true });
      } else {
        scheduleOpen(preloader ? 350 : 1500);
      }
    }
  }
</script>
