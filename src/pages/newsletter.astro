---
import { randomUUID } from "node:crypto";
import PageShell from "../layouts/PageShell.astro";
import { NEWSLETTER_PDF_PATH } from "../config/email-marketing";
export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");
const sent = Astro.url.searchParams.get("sent") === "1";
const failed = Astro.url.searchParams.get("error") === "1";
---
<PageShell title="Newsletter de Imperio Español" heading="Historias por correo" summary="Recibe historias, novedades, lanzamientos y ofertas de Imperio Español. Empieza con 7 historias del Siglo de Oro en PDF, gratis." narrow mainClass="newsletter-page">
  <section class="newsletter-content" aria-label="Suscripción a la newsletter">
    <form action="/api/manifesto.php" method="post" id="newsletter-form" data-funnel-flow="newsletter">
      <input type="hidden" name="requestId" value={randomUUID()} />
      <input type="hidden" name="anonymousId" value={randomUUID()} />
      <div class="trap" aria-hidden="true"><label>Empresa<input name="company" tabindex="-1" autocomplete="off" /></label></div>
      <label for="newsletter-email">Tu correo</label>
      <input id="newsletter-email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="nombre@ejemplo.com" />
      <p class="consent-note">Al pulsar el botón solicitas recibir estos correos. Baja cuando quieras, sin crear una cuenta. Consulta la <a href="/legal/privacidad">política de privacidad</a>.</p>
      <button type="submit" name="intent" value="newsletter_pdf">Suscribirme y recibir el PDF</button>
      <p id="newsletter-status" role="status" aria-live="polite">{sent ? "Solicitud recibida. Revisa tu correo y, si no aparece, la carpeta de spam." : failed ? "No hemos podido enviar el correo. Inténtalo de nuevo." : ""}</p>
    </form>
    <a class="download-only" href={NEWSLETTER_PDF_PATH} download>Solo descargar el PDF, sin suscribirme</a>
    <p class="account-link">¿Ya tienes cuenta? <a href="/cuenta#comunicaciones">Gestiona tus comunicaciones</a>.</p>
  </section>
</PageShell>
<script>
  import { trackFunnel } from "../lib/funnel-client";
  const form = document.querySelector<HTMLFormElement>("#newsletter-form");
  const status = document.querySelector<HTMLElement>("#newsletter-status");
  const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");
  let attemptedEmail = "";
  form?.addEventListener("submit", async event => {
    event.preventDefault();
    if(!form.reportValidity() || !button || button.disabled || !status)return;
    const data = new FormData(form);
    const email = String(data.get("email") || "").trim().toLowerCase();
    if(attemptedEmail && attemptedEmail !== email){
      const id=form.querySelector<HTMLInputElement>('[name="requestId"]')!;id.value=crypto.randomUUID();data.set("requestId",id.value);
    }
    attemptedEmail=email;
    data.set("intent","newsletter_pdf");
    button.disabled=true;button.textContent="Enviando…";status.textContent="";
    try {
      const response=await fetch(form.action,{method:"POST",headers:{Accept:"application/json"},body:new URLSearchParams(data as unknown as Record<string,string>)});
      const result=await response.json();
      if(!response.ok || !result.ok)throw Error(result.error || "No hemos podido enviar el correo.");
      status.textContent="Tu PDF está en camino. Revisa tu correo y, si no aparece, la carpeta de spam.";
      trackFunnel("newsletter",4);
      button.textContent="Solicitud enviada";
    } catch(error) {
      status.textContent=error instanceof Error?error.message:"No hemos podido enviar el correo. Inténtalo de nuevo.";
      button.disabled=false;button.textContent="Suscribirme y recibir el PDF";
    }
  });
</script>
<style>
  :global(.newsletter-page .page-shell__intro){max-width:640px;margin:auto;padding-bottom:24px}
  .newsletter-content{max-width:640px;margin:auto;padding-bottom:56px;overflow-wrap:anywhere}
  form{position:relative;display:grid;gap:14px}
  label{font-weight:700}input[type=email]{box-sizing:border-box;width:100%;min-height:52px;padding:12px 16px;border:1px solid #ffffff70;border-radius:6px;background:#ffffff0d;color:#fff;font:inherit}
  input::placeholder{color:#655852}button{min-height:52px;padding:14px 20px;background:#ffffff1c;border:1px solid #ffffff70;border-radius:6px;color:#fff;font:700 17px/1.4 Arial,sans-serif;cursor:pointer}
  button:hover{background:#ffffff30}button:disabled{cursor:default;opacity:.7}button:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid #fff;outline-offset:4px}
  .consent-note,.account-link{font-size:14px;line-height:1.6;color:#e0dcdc;margin:0}.newsletter-content a{color:inherit;text-decoration:underline;text-underline-offset:3px}
  #newsletter-status{min-height:24px;margin:0;line-height:1.6}.download-only{display:inline-block;margin:24px 0 16px;font-size:15px}
  .trap{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
</style>
