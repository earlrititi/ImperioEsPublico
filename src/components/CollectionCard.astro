---
// Generic content card for collection and archive listings.
interface Props {
  meta?: string;
  title: string;
  summary: string;
  href: string;
  ctaLabel?: string;
  ctaVariant?: "ghost" | "primary";
  headingLevel?: 2 | 3;
}

const {
  meta,
  title,
  summary,
  href,
  ctaLabel = "Ver",
  ctaVariant = "ghost",
  headingLevel = 2,
} = Astro.props as Props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<article class="card collection-card">
  {meta && <p class="muted">{meta}</p>}
  <Heading>{title}</Heading>
  <p>{summary}</p>
  <slot />
  <a class={`btn btn-${ctaVariant}`} href={href} aria-label={`${ctaLabel}: ${title}`}>{ctaLabel}</a>
</article>
