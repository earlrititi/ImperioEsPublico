---
import PageShell from "../layouts/PageShell.astro";
import SubscriptionConfirmation from "../components/commerce/SubscriptionConfirmation";
import "../styles/commerce.css";
export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
const receiptId = Astro.url.searchParams.get("session_id") ?? "";
const sessionId = /^cs_(live|test)_[A-Za-z0-9]{1,190}$/.test(receiptId) ? receiptId : "";
---

<PageShell
  title="Estado de tu suscripcion | Imperio E"
  description="Estamos confirmando tu suscripcion de forma segura."
  eyebrow="Confirmacion"
  heading="Tu suscripcion"
  summary="Consulta el estado de tu acceso despues del pago seguro."
  noindex
  narrow
>
  <SubscriptionConfirmation sessionId={sessionId} client:load />
  <noscript><p>Consulta tu suscripcion en <a href="/cuenta">tu cuenta</a>. Te avisaremos por correo cuando se confirme. No repitas el pago.</p></noscript>
</PageShell>
