---
import PageShell from "../layouts/PageShell.astro";
import AuthEmailForm from "../components/AuthEmailForm.astro";
import { requestAuthEmail } from "../lib/auth-email-request";
import { privateAuthHeaders } from "../lib/auth-forms";
privateAuthHeaders(Astro.response.headers);
if (Astro.request.method === "POST") return requestAuthEmail(Astro, "confirmation");
---
<PageShell title="Confirmar correo | Imperio Español" description="Confirma el correo de tu cuenta." heading="Confirmar correo" noindex narrow>
  <Fragment slot="header"><AuthEmailForm purpose="confirmation" sent={Astro.url.searchParams.get('sent') === '1'} error={Astro.url.searchParams.get('error')} /></Fragment>
</PageShell>
