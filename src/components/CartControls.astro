<script>
  import { changeCart, readCart, saveCart, SHIRT_SIZES, type ShirtSize } from "../lib/cart";
  import { trackGoogleCommerce } from "../lib/google-analytics";
  for (const form of document.querySelectorAll<HTMLFormElement>(".product-purchase")) {
    form.addEventListener("submit", () => {
      const size = form.querySelector<HTMLSelectElement>("[data-shirt-size]")?.value as ShirtSize;
      if (SHIRT_SIZES.includes(size)) trackGoogleCommerce("begin_checkout", [{ size, quantity: 1 }]);
    });
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-cart-add]")) {
    button.addEventListener("click", () => {
      const form = button.closest("form");
      const select = form?.querySelector<HTMLSelectElement>("[data-shirt-size]");
      const status = form?.querySelector<HTMLElement>("[data-cart-feedback]");
      if (!select || !SHIRT_SIZES.includes(select.value as ShirtSize)) return;
      try {
        const size = select.value as ShirtSize;
        const current = readCart();
        const quantity = (current.find(item => item.size === size)?.quantity ?? 0) + 1;
        saveCart(changeCart(current, size, quantity));
        if (!readCart().some(item => item.size === size && item.quantity === quantity)) throw Error("STORAGE_BLOCKED");
        trackGoogleCommerce("add_to_cart", [{ size, quantity: 1 }]);
        if (status) status.hidden = false;
      } catch { if (status) { status.hidden = false; status.textContent = "No se pudo guardar el carrito. Puedes comprar directamente."; } }
    });
  }
  let viewed = false;
  const product = document.querySelector<HTMLElement>("[data-shirt-product]");
  if (product) {
    let visible = false;
    const record = () => {
      if (viewed || !visible) return;
      const selected = product.querySelector<HTMLSelectElement>("select")?.value as ShirtSize;
      viewed = trackGoogleCommerce("view_item", [{ size: SHIRT_SIZES.includes(selected) ? selected : "M", quantity: 1 }]);
    };
    new IntersectionObserver(entries => { visible = entries.some(e => e.isIntersecting); record(); }, { threshold: 0.1 }).observe(product);
    window.addEventListener("imperio:cookie-consent", record);
  }
</script>
