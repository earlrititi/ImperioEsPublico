---
import InteractionTracker from "../components/InteractionTracker.astro";
import FunnelTracker from "../components/FunnelTracker.astro";
import "../styles/global.css";
import "../styles/navigation.css";
import ClientRuntime from "../islands/ClientRuntime.astro";
import CookieConsent from "../components/CookieConsent.astro";
import TshirtLeadPopup from "../components/TshirtLeadPopup.astro";
import Footer from "../components/Footer.jsx";
import GlobalHomeMark from "../components/GlobalHomeMark.astro";
import Navigation from "../components/Navigation.jsx";
import { SITE } from "../config/site";
import { withBase } from "../utils/basePath";
import { canonicalUrl as buildCanonicalUrl, hasSearchParameters, serializeJsonLd } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  footerVariant?: "light" | "dark";
  showFooter?: boolean;
  showCookieConsent?: boolean;
  navigation?: "persistent" | "home";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: "website" | "article";
  publishedAt?: string;
  modifiedAt?: string;
  exactTitle?: boolean;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  ogImage = SITE.defaultOgImage,
  noindex = false,
  footerVariant = "light",
  showFooter = true,
  showCookieConsent = true,
  navigation = "persistent",
  structuredData,
  ogType = "website",
  publishedAt,
  modifiedAt,
  exactTitle = false,
} = Astro.props as Props;

const pageTitle =
  exactTitle || title === SITE.name || title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const isGitHubPagesBuild = import.meta.env.BASE_URL.startsWith("/Imperio_web");
const deploymentOrigin =
  isGitHubPagesBuild ? "https://earlrititi-lang.github.io" : SITE.url;
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);
const excluded = noindex || hasSearchParameters(Astro.url) || (Astro.response.status ?? 200) >= 400;
const ogImageUrl = new URL(withBase(ogImage), deploymentOrigin).toString();
const organizationSchema = {
  "@type": "Organization",
  "@id": `${SITE.url}/#organization`,
  name: SITE.name,
  alternateName: SITE.alternateName,
  url: SITE.url,
  logo: new URL("/images/logo-redv2.png", SITE.url).toString(),
  email: SITE.contactEmail,
  description: SITE.defaultDescription,
  sameAs: SITE.sameAs,
};
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [organizationSchema, {
    "@type": "WebSite", "@id": `${SITE.url}/#website`, name: SITE.name,
    url: SITE.url, inLanguage: "es", publisher: { "@id": `${SITE.url}/#organization` },
  }, {
    "@type": "WebPage", "@id": `${canonicalUrl}#webpage`, url: canonicalUrl,
    name: pageTitle, description, inLanguage: "es", isPartOf: { "@id": `${SITE.url}/#website` },
  }, ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="facebook-domain-verification" content="ux942tlzl36w3qi07b2mi402t806l9" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={excluded ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="x-runtime-stack" content="astro,google-tag,cloudflare-ready" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    {ogType === "article" && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {ogType === "article" && modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="alternate" type="application/rss+xml" title={`Artículos de ${SITE.name}`} href={withBase("/feed.xml")} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${withBase("/favicon-32x32.png")}?v=20260902`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${withBase("/favicon-16x16.png")}?v=20260902`}
    />
    <link rel="icon" href={`${withBase("/favicon.ico")}?v=20260902`} sizes="any" />
    <link rel="shortcut icon" href={`${withBase("/favicon.ico")}?v=20260902`} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={withBase("/apple-touch-icon.png")}
    />
    <link rel="manifest" href={withBase("/site.webmanifest")} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="application-name" content={SITE.name} />
    <meta name="theme-color" content="#f2381e" />
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(jsonLd)}
    ></script>

  </head>
  <body>
    <noscript><style is:global>.fade-in-up, .reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <GlobalHomeMark />
    {navigation === "persistent" && <Navigation persistent />}
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    {showFooter && <Footer variant={footerVariant} />}
    <div id="imperio-scrollbar" aria-hidden="true">
      <div id="imperio-scrollbar-track">
        <div id="imperio-scrollbar-thumb"></div>
      </div>
    </div>
    <ClientRuntime />
    {!noindex && <InteractionTracker />}
    {!noindex && <FunnelTracker />}
    <TshirtLeadPopup />
    {showCookieConsent && <CookieConsent />}
    <script>
      const accountButtons = Array.from(document.querySelectorAll("[data-account-button]"));
      if (accountButtons.length) {
        const cacheKey = "imperio:account-label:v1";
        const applyEmail = (email: string) => {
          accountButtons.forEach((button) => {
            if (!(button instanceof HTMLAnchorElement)) return;
            const label = document.createElement("span");
            label.className = "account-button__email";
            label.textContent = email;
            button.replaceChildren(label);
            button.classList.add("account-button--email");
            button.setAttribute("aria-label", `Mi cuenta: ${email}`);
            button.title = email;
          });
        };

        let cached: { email?: string; checkedAt?: number } | null = null;
        try {
          cached = JSON.parse(sessionStorage.getItem(cacheKey) || "null");
        } catch {}

        if (cached?.email) applyEmail(cached.email);
        const cacheIsFresh = Boolean(
          cached?.email && cached?.checkedAt && Date.now() - cached.checkedAt < 300_000
        );
        const hasAuthCookie = document.cookie
          .split(";")
          .some((cookie) => /^\s*sb-[^=]+-auth-token(?:\.\d+)?=/.test(cookie));

        const refreshAccount = async () => {
          if (cacheIsFresh || !hasAuthCookie) return;
          try {
            const response = await fetch("/api/auth/session", {
              credentials: "same-origin",
              headers: { Accept: "application/json" },
            });
            const data = response.ok ? await response.json() : null;
            if (typeof data?.email === "string" && data.email) applyEmail(data.email);
            if (typeof data?.email === "string" && data.email) {
              sessionStorage.setItem(cacheKey, JSON.stringify({
                email: data.email,
                checkedAt: Date.now(),
              }));
            } else {
              sessionStorage.removeItem(cacheKey);
            }
          } catch {}
        };

        const scheduleRefresh = () => {
          if (typeof window.requestIdleCallback === "function") {
            window.requestIdleCallback(() => void refreshAccount(), { timeout: 4_000 });
          } else {
            globalThis.setTimeout(() => void refreshAccount(), 2_500);
          }
        };
        if (document.readyState === "complete") scheduleRefresh();
        else window.addEventListener("load", scheduleRefresh, { once: true });
      }
    </script>
  </body>
</html>
