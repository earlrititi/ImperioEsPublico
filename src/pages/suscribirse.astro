---
import PageShell from "../layouts/PageShell.astro";
import { ES_VAT } from "../config/tax";
---

<PageShell
  title="Suscríbete al archivo y la comunidad | Imperio Español"
  description="Elige tu acceso a Imperio Espanol: Piquero, Arcabucero o Maestre de Campo."
  eyebrow="Acceso"
  heading="Elige tu acceso"
  summary="Compara el acceso a las publicaciones y las ventajas de cada plan. El pago se procesa de forma segura en Stripe Checkout."
>
  <section class="section">
    <p class="muted">{ES_VAT.description} Aplicable a los planes mensuales y anuales.</p>
    <div class="grid subscribe-grid">
      <article class="card subscribe-card">
        <span class="badge">Gratis</span>
        <h2>PIQUERO</h2>
        <p class="plan-summary">Explora Imperio Español y lee las publicaciones abiertas.</p>
        <dl class="plan-features">
          <div><dt>Mensual</dt><dd>GRATIS</dd></div>
          <div><dt>Anual</dt><dd>—</dd></div>
          <div><dt>Función</dt><dd>Explorar</dd></div>
          <div><dt>Foro</dt><dd>Leer</dd></div>
          <div><dt>Discord</dt><dd><span aria-label="No incluido">❌</span></dd></div>
          <div><dt>Artículos</dt><dd>Limitado</dd></div>
          <div><dt>Archivo</dt><dd>Limitado</dd></div>
          <div><dt>Lanzamientos anticipados</dt><dd><span aria-label="Incluido">✅</span></dd></div>
          <div><dt>Descuento drops</dt><dd><span aria-label="No incluido">❌</span></dd></div>
          <div><dt>Bonus anual</dt><dd><span aria-label="No incluido">❌</span></dd></div>
        </dl>
        <a class="btn btn-ghost" href="/registro">Crear cuenta gratis</a>
      </article>

      <article class="card subscribe-card" id="arcabucero">
        <span class="badge">Desde 1,99 € / mes</span>
        <h2>ARCABUCERO</h2>
        <p class="plan-summary">Accede al contenido para suscriptores y a todo el catálogo publicado.</p>
        <dl class="plan-features">
          <div><dt>Mensual</dt><dd>1,99 €</dd></div>
          <div><dt>Anual</dt><dd>17,99 €</dd></div>
          <div><dt>Función</dt><dd><strong>Acceder</strong></dd></div>
          <div><dt>Foro</dt><dd>Comentar</dd></div>
          <div><dt>Discord</dt><dd>Básico</dd></div>
          <div><dt>Artículos</dt><dd><strong>Ilimitado + 1 nuevos artículos semanales</strong></dd></div>
          <div><dt>Archivo</dt><dd><strong>Completo</strong></dd></div>
          <div><dt>Lanzamientos anticipados</dt><dd class="plan-status-value"><span aria-label="Incluido">✅</span><strong>48h antes</strong></dd></div>
          <div><dt>Descuento drops</dt><dd class="plan-status-value"><span aria-label="Incluido">✅</span><strong>15%</strong></dd></div>
          <div><dt>Bonus anual</dt><dd><strong>Insignia</strong></dd></div>
        </dl>
        <div class="billing-options" role="group" aria-label="Facturación de Arcabucero">
          <a class="btn btn-primary" href="/checkout/arcabucero-monthly">
            Elegir mensual · 1,99 €
          </a>
          <a class="btn btn-primary" href="/checkout/arcabucero-annual">
            Elegir anual · 17,99 €
          </a>
        </div>
      </article>

      <article class="card subscribe-card" id="maestre-de-campo">
        <span class="badge">Desde 3,99 € / mes</span>
        <h2>MAESTRE DE CAMPO</h2>
        <p class="plan-summary">Participa con una aportación mayor para sostener el crecimiento del proyecto.</p>
        <dl class="plan-features">
          <div><dt>Mensual</dt><dd>3,99 €</dd></div>
          <div><dt>Anual</dt><dd>37,99 €</dd></div>
          <div><dt>Función</dt><dd>Participar</dd></div>
          <div><dt>Foro</dt><dd><strong>Crear temas</strong></dd></div>
          <div><dt>Discord</dt><dd><strong>Completo</strong></dd></div>
          <div><dt>Artículos</dt><dd><strong>Ilimitado + 2 nuevos artículos semanales</strong></dd></div>
          <div><dt>Archivo</dt><dd><strong>Completo</strong></dd></div>
          <div><dt>Lanzamientos anticipados</dt><dd class="plan-status-value"><span aria-label="Incluido">✅</span><strong>72h antes</strong></dd></div>
          <div><dt>Descuento drops</dt><dd class="plan-status-value"><span aria-label="Incluido">✅</span><strong>20%</strong></dd></div>
          <div><dt>Bonus anual</dt><dd>Lámina + pack digital</dd></div>
        </dl>
        <div class="billing-options" role="group" aria-label="Facturación de Maestre de Campo">
          <a class="btn btn-primary" href="/checkout/maestre-campo-monthly">
            Elegir mensual · 3,99 €
          </a>
          <a class="btn btn-primary" href="/checkout/maestre-campo-annual">
            Elegir anual · 37,99 €
          </a>
        </div>
      </article>
    </div>
  </section>
</PageShell>

<style>
  .subscribe-grid {
    align-items: stretch;
  }

  .subscribe-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: var(--space-2);
    align-content: stretch;
    scroll-margin-top: 7rem;
  }

  .subscribe-card h2,
  .plan-summary,
  .plan-features {
    margin: 0;
  }

  .plan-summary {
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .plan-features {
    display: grid;
    align-self: start;
    border-block: 1px solid var(--line);
  }

  .plan-features > div {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 0.75rem;
    align-items: center;
    min-height: 3.75rem;
    padding: 0.45rem 0;
    border-top: 1px solid var(--line);
  }

  .plan-features > div:first-child {
    border-top: 0;
  }

  .plan-features dt {
    color: var(--ink-soft);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .plan-features dd {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1.35;
    text-align: right;
  }

  .plan-features dd span {
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 400;
  }

  .plan-features .plan-status-value {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.35rem;
  }

  .plan-features .plan-status-value span {
    color: inherit;
    font-size: 0.9rem;
  }

  .subscribe-card:target {
    border-color: var(--color-red-accent);
    box-shadow: 0 0 0 3px rgb(242 56 30 / 20%);
  }

  .subscribe-card .btn {
    width: 100%;
  }

  .billing-options {
    display: grid;
    gap: 0.45rem;
    align-self: end;
    margin-top: var(--space-2);
  }

  @media (max-width: 360px) {
    .plan-features > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .plan-features dd {
      text-align: left;
    }

    .plan-features .plan-status-value {
      justify-content: flex-start;
    }
  }

</style>
