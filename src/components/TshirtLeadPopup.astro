---
const excluded = /^\/(?:login|registro|recuperar-contrasena|confirmar-correo|checkout|reservas(?:\/|$)|reserva(?:\/|$)|compra(?:\/|$)|gracias(?:\/|$)|admin(?:\/|$))/;
const enabled = !excluded.test(Astro.url.pathname);
---

{enabled && (
  <div class="tshirt-lead" data-tshirt-lead hidden>
    <button class="tshirt-lead__backdrop" type="button" data-tshirt-close tabindex="-1" aria-label="Cerrar"></button>
    <section class="tshirt-lead__dialog" role="dialog" aria-modal="true" aria-labelledby="tshirt-lead-title" aria-describedby="tshirt-lead-copy">
      <button class="tshirt-lead__close" type="button" data-tshirt-close aria-label="Cerrar oferta" title="Cerrar">&times;</button>
      <div class="tshirt-lead__media">
        <img src="/images/camiseta-imperio-frontal.webp" alt="Camiseta Imperial de Imperio E" width="1080" height="1080" loading="lazy" decoding="async" />
      </div>
      <div class="tshirt-lead__content">
        <span class="tshirt-lead__eyebrow">20% de descuento</span>
        <h2 id="tshirt-lead-title">Una pieza de nuestra historia.</h2>
        <p id="tshirt-lead-copy">Déjanos tu nombre y correo y recibe un 20% de descuento para tu Camiseta Imperial.</p>
        <form data-tshirt-form>
          <label for="tshirt-lead-name">Nombre</label>
          <input id="tshirt-lead-name" name="name" autocomplete="name" minlength="2" maxlength="150" required />
          <label for="tshirt-lead-email">Correo electrónico</label>
          <input id="tshirt-lead-email" name="email" type="email" autocomplete="email" maxlength="254" required />
          <label class="tshirt-lead__consent">
            <input name="marketingAccepted" type="checkbox" required />
            <span>Quiero recibir este descuento y novedades seleccionadas de Imperio E. He leído la <a href="/legal/privacidad">Política de Privacidad</a>.</span>
          </label>
          <input class="tshirt-lead__trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn btn-primary tshirt-lead__submit" type="submit">Conseguir mi 20%</button>
          <p class="tshirt-lead__fineprint">Sin spam. Solo novedades de Imperio E y lanzamientos seleccionados.</p>
          <p class="tshirt-lead__status" data-tshirt-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </div>
)}

<style>
  .tshirt-lead{position:fixed;inset:0;z-index:12000;display:grid;place-items:center;padding:20px;opacity:0;transition:opacity 280ms ease}
  .tshirt-lead[hidden]{display:none}
  .tshirt-lead[data-open]{opacity:1}
  .tshirt-lead__backdrop{position:absolute;inset:0;width:100%;height:100%;border:0;background:rgb(11 12 12 / 72%);cursor:default}
  .tshirt-lead__dialog{position:relative;display:grid;grid-template-columns:minmax(260px,.85fr) minmax(320px,1.15fr);width:min(900px,100%);max-height:min(720px,calc(100vh - 40px));overflow:auto;background:var(--color-white-off);border:1px solid rgb(212 175 55 / 55%);box-shadow:0 24px 70px rgb(0 0 0 / 38%);transform:translateY(12px);transition:transform 280ms ease}
  .tshirt-lead[data-open] .tshirt-lead__dialog{transform:translateY(0)}
  .tshirt-lead__close{position:absolute;top:10px;right:10px;z-index:2;width:44px;height:44px;border:0;background:rgb(250 250 250 / 92%);color:#111;font-size:30px;line-height:1;cursor:pointer}
  .tshirt-lead__media{display:grid;place-items:center;min-height:100%;padding:28px;background:#ece9e3;border-right:1px solid var(--line);overflow:hidden}
  .tshirt-lead__media img{width:100%;height:100%;max-height:560px;object-fit:contain}
  .tshirt-lead__content{position:relative;padding:clamp(28px,5vw,52px)}
  .tshirt-lead__content::before{content:"";position:absolute;top:0;left:clamp(28px,5vw,52px);width:82px;height:3px;background:var(--color-gold)}
  .tshirt-lead__eyebrow{display:block;margin-bottom:10px;color:var(--color-red-deep);font-size:13px;font-weight:700;text-transform:uppercase}
  .tshirt-lead h2{margin:0 0 12px;font-family:var(--font-serif);font-size:clamp(2rem,4vw,3rem);line-height:1}
  .tshirt-lead p{line-height:1.55}
  .tshirt-lead form{display:grid;gap:8px;margin-top:22px}
  .tshirt-lead label:not(.tshirt-lead__consent){margin-top:5px;font-size:12px;font-weight:700;text-transform:uppercase}
  .tshirt-lead input:not([type=checkbox]){width:100%;min-height:46px;border:1px solid #928d84;border-radius:4px;background:#fff;padding:10px 12px;font:inherit}
  .tshirt-lead__consent{display:flex;align-items:flex-start;gap:10px;margin:8px 0 2px;font-size:12px;line-height:1.45}
  .tshirt-lead__consent input{margin-top:3px;flex:0 0 auto}
  .tshirt-lead__consent a{text-decoration:underline;text-underline-offset:2px}
  .tshirt-lead__submit{width:100%;min-height:48px;margin-top:4px;text-transform:uppercase}
  .tshirt-lead__fineprint,.tshirt-lead__status{margin:4px 0 0;font-size:12px}
  .tshirt-lead__status:not(:empty){padding-left:10px;border-left:3px solid var(--color-gold)}
  .tshirt-lead__trap{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important}
  @media(max-width:680px){.tshirt-lead{padding:10px;align-items:end}.tshirt-lead__dialog{grid-template-columns:1fr;max-height:calc(100vh - 20px)}.tshirt-lead__media{min-height:0;height:180px;padding:12px;border-right:0;border-bottom:1px solid var(--line)}.tshirt-lead__media img{width:auto;max-width:100%;height:100%;max-height:100%;object-fit:contain}.tshirt-lead__content{padding:24px 18px}.tshirt-lead__content::before{left:18px}.tshirt-lead h2{font-size:2rem}.tshirt-lead__close{top:6px;right:6px}}
  @media(prefers-reduced-motion:reduce){.tshirt-lead,.tshirt-lead__dialog{transition:none}}
</style>

<script>
  const root = document.querySelector('[data-tshirt-lead]');
  if (root instanceof HTMLElement) {
    const storageKey = 'imperio:tshirt-lead';
    const form = root.querySelector('[data-tshirt-form]');
    const status = root.querySelector('[data-tshirt-status]');
    const closeButtons = root.querySelectorAll('[data-tshirt-close]');
    let previousOverflow = '';
    let lastFocus: Element | null = null;
    const now = Date.now();
    let hiddenUntil = 0;
    try { hiddenUntil = Number(JSON.parse(localStorage.getItem(storageKey) || '{}').until || 0); } catch {}

    const focusable = (): HTMLElement[] => Array.from(root.querySelectorAll('a[href],button:not([disabled]),input:not([disabled]):not([tabindex="-1"])')).filter((item): item is HTMLElement => item instanceof HTMLElement && item.offsetParent !== null);
    const persist = (days: number, state: string) => {
      try { localStorage.setItem(storageKey, JSON.stringify({ state, until: Date.now() + days * 86400000 })); } catch {}
    };
    const close = (days = 7, state = 'closed') => {
      persist(days, state);
      root.removeAttribute('data-open');
      window.setTimeout(() => { root.hidden = true; document.body.style.overflow = previousOverflow; if (lastFocus instanceof HTMLElement) lastFocus.focus(); }, window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 280);
    };
    const open = () => {
      lastFocus = document.activeElement;
      previousOverflow = document.body.style.overflow;
      root.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => { root.setAttribute('data-open', ''); root.querySelector('input')?.focus(); });
    };
    closeButtons.forEach((button) => button.addEventListener('click', () => close()));
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { event.preventDefault(); close(); return; }
      if (event.key !== 'Tab') return;
      const items = focusable();
      if (!items.length) return;
      const first = items[0], last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
      const submit = form.querySelector('button[type="submit"]');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      status.textContent = 'Registrando tu descuento...';
      const values = Object.fromEntries(new FormData(form));
      try {
        const response = await fetch('/api/tshirt-lead', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ name:values.name, email:values.email, marketingAccepted:values.marketingAccepted === 'on', website:values.website }) });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'No se pudo guardar el registro.');
        status.textContent = '¡Listo! Revisa tu correo para obtener tu descuento.';
        persist(365, 'registered');
        form.querySelectorAll('input,button').forEach((control) => { if (control instanceof HTMLInputElement || control instanceof HTMLButtonElement) control.disabled = true; });
        window.setTimeout(() => close(365, 'registered'), 2400);
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'No se pudo guardar el registro.';
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
    const scheduleOpen = (delay: number) => window.setTimeout(() => {
      let currentUntil = hiddenUntil;
      try { currentUntil = Number(JSON.parse(localStorage.getItem(storageKey) || '{}').until || 0); } catch {}
      if (currentUntil <= Date.now() && root.hidden) open();
    }, delay);
    if (hiddenUntil <= now) {
      const preloader = document.getElementById('preloader');
      if (preloader && !document.body.classList.contains('preloader-done')) {
        window.addEventListener('preloader:done', () => scheduleOpen(650), { once:true });
      } else {
        scheduleOpen(preloader ? 650 : 2200);
      }
    }
  }
</script>
