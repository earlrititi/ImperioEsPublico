---
import Layout from "../../layouts/Layout.astro";
import ReservationForm from "../../components/commerce/ReservationForm";
import { SHIRT_FINAL_PRICE_CENTS } from "../../config/commerce";
import { SHIRT_SIZES } from "../../lib/cart";
import { shirtCheckoutPublishableKey } from "../../lib/reservation-payment";
import { reservationMode } from "../../lib/reservations";
import { createSupabaseServerClient } from "../../lib/supabase/server";
import "../../styles/shirt-checkout.css";

export const prerender = false;

const requestedSize = Astro.url.searchParams.get("size");
const requestedQuantity = Number(Astro.url.searchParams.get("quantity") ?? "1");
const initialSize = SHIRT_SIZES.find((size) => size === requestedSize) ?? "M";
const initialQuantity = Number.isSafeInteger(requestedQuantity) && requestedQuantity > 0 &&
  requestedQuantity <= Math.floor(2_147_483_647 / SHIRT_FINAL_PRICE_CENTS) ? requestedQuantity : 1;
const fromCart = Astro.url.searchParams.get("cart") === "1";
const startsAsReservation = reservationMode();
const { data: { user } } = await createSupabaseServerClient({ cookies: Astro.cookies, request: Astro.request }).auth.getUser();
const initialCustomer = { name: typeof user?.user_metadata?.full_name === "string" ? user.user_metadata.full_name : "", email: user?.email ?? "" };
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---
<Layout title="Camiseta Imperial | Imperio Español" description="Datos de contacto, entrega y pago de la Camiseta Imperial." noindex>
  <main class="shirt-checkout-page">
    <div class="shirt-checkout-page__inner">
      <header class="shirt-checkout-page__header">
        <a href={fromCart ? "/carrito" : "/tienda#camiseta"}><span aria-hidden="true">←</span> Volver a {fromCart ? "mi carrito" : "la tienda"}</a>
        <h1>{startsAsReservation ? "Reserva tu camiseta" : "Finalizar compra"}</h1>
      </header>
      <ReservationForm client:load {initialSize} {initialQuantity} {initialCustomer} {fromCart}
        initialSales={!startsAsReservation} stripePublishableKey={shirtCheckoutPublishableKey()} />
    </div>
  </main>
</Layout>
