---
import { PRELOADER_SESSION_KEY } from "../config/hero";
import { withBase } from "../utils/basePath";

const preloaderSessionKey = PRELOADER_SESSION_KEY;
---

<a
  class="global-home-mark"
  href={withBase("/")}
  aria-label="Volver al hero"
  title="Volver al hero"
  data-return-to-hero
>
  <img
    class="global-home-mark__image"
    src={withBase("/images/logo-redv2-96.webp")}
    alt=""
    aria-hidden="true"
    width="96"
    height="74"
    loading="eager"
    decoding="async"
  />
</a>

<script is:inline define:vars={{ preloaderSessionKey }}>
  if (!window.__imperioHeroReturnBound) {
    window.__imperioHeroReturnBound = true;
    document.addEventListener("click", (event) => {
      const target = event.target;
      const link =
        target instanceof Element ? target.closest("[data-return-to-hero]") : null;

      if (!link) return;

      try {
        window.sessionStorage.setItem(preloaderSessionKey, "1");
      } catch {
        // El enlace sigue funcionando si el navegador bloquea el storage.
      }
    });
  }
</script>

<script>
  const homeMark = document.querySelector(".global-home-mark");

  if (homeMark instanceof HTMLElement) {
    let markFrame = 0;

    const colorProbe = document.createElement("span");
    colorProbe.hidden = true;
    colorProbe.style.position = "fixed";
    colorProbe.style.pointerEvents = "none";
    document.body.append(colorProbe);

    const resolveColor = (value: string) => {
      colorProbe.style.color = value;
      return window.getComputedStyle(colorProbe).color;
    };

    const redSurfaceColor = resolveColor("var(--color-red-accent)");
    const blackSurfaceColor = resolveColor("var(--color-black-papers)");
    colorProbe.remove();

    const updateMarkSurface = () => {
      markFrame = 0;
      const markRect = homeMark.getBoundingClientRect();
      const markX = markRect.left + markRect.width / 2;
      const markY = markRect.top + markRect.height / 2;
      const surfaces = document
        .elementsFromPoint(markX, markY)
        .filter((element) => element !== homeMark && !homeMark.contains(element));
      const isOverRed = surfaces.some(
        (surface) =>
          surface.getAttribute("data-home-mark-surface") === "red" ||
          window.getComputedStyle(surface).backgroundColor === redSurfaceColor,
      );
      const isOverBlack =
        !isOverRed &&
        surfaces.some(
          (surface) =>
            surface.getAttribute("data-home-mark-surface") === "black" ||
            window.getComputedStyle(surface).backgroundColor === blackSurfaceColor,
        );

      homeMark.classList.toggle("global-home-mark--on-red", isOverRed);
      homeMark.classList.toggle("global-home-mark--on-black", isOverBlack);
    };

    const queueMarkSurfaceUpdate = () => {
      if (markFrame) return;
      markFrame = window.requestAnimationFrame(updateMarkSurface);
    };

    queueMarkSurfaceUpdate();
    window.addEventListener("scroll", queueMarkSurfaceUpdate, { passive: true });
    window.addEventListener("resize", queueMarkSurfaceUpdate);
    homeMark.addEventListener("pointerenter", queueMarkSurfaceUpdate);
  }
</script>

<style>
  .global-home-mark {
    position: fixed;
    top: max(
      calc(var(--space-unit) * 4 - 1.475rem),
      env(safe-area-inset-top)
    );
    left: max(4px, env(safe-area-inset-left));
    z-index: 175;
    display: inline-flex;
    align-items: center;
    width: auto;
    height: 2.95rem;
    aspect-ratio: 602 / 477;
    color: inherit;
    background: transparent;
    border: 0;
    filter: drop-shadow(0 2px 5px rgba(255, 255, 255, 0.24));
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .global-home-mark:hover,
  .global-home-mark:focus-visible,
  .global-home-mark:active {
    opacity: 0.76;
    transform: translateY(-2px);
  }

  .global-home-mark:focus-visible {
    outline: 2px solid var(--color-red-accent);
    outline-offset: 5px;
  }

  .global-home-mark__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: none;
    transition: filter 160ms ease;
  }

  :global(body:has(#main-nav) .global-home-mark) {
    display: none;
  }

  :global(body:has(.in-work-page) .global-home-mark),
  :global(body:has(.storefront) .global-home-mark),
  :global(body:has(.papers-page) .global-home-mark),
  :global(body:has(.article-page) .global-home-mark),
  .global-home-mark--on-black {
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.88));
  }

  :global(body:has(.in-work-page) .global-home-mark__image),
  :global(body:has(.storefront) .global-home-mark__image),
  :global(body:has(.papers-page) .global-home-mark__image),
  :global(body:has(.article-page) .global-home-mark__image),
  .global-home-mark--on-black .global-home-mark__image {
    filter: brightness(0) invert(1);
  }

  .global-home-mark:hover .global-home-mark__image,
  .global-home-mark:focus-visible .global-home-mark__image,
  .global-home-mark:active .global-home-mark__image {
    filter: none;
  }

  .global-home-mark--on-red:hover .global-home-mark__image,
  .global-home-mark--on-red:focus-visible .global-home-mark__image,
  .global-home-mark--on-red:active .global-home-mark__image {
    filter: brightness(0);
  }

  @media (max-width: 767px) {
    .global-home-mark {
      top: max(
        clamp(0.475rem, calc(1.75rem - 5vw), 0.7rem),
        env(safe-area-inset-top)
      );
      width: auto;
      height: clamp(2.1rem, 10vw, 2.55rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .global-home-mark {
      transition: none;
    }
  }
</style>
