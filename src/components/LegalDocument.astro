---
import PageShell from "../layouts/PageShell.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  version: string;
}

const {
  title,
  description,
  heading,
  version,
} = Astro.props as Props;
---

<PageShell
  title={title}
  description={description}
  eyebrow="Informacion legal"
  heading={heading}
  summary={`Version ${version}`}
  mainClass="legal-page"
  narrow
>
  <section class="section legal-document">
    <slot />
  </section>
</PageShell>

<style>
  :global(.legal-page) { background:#fbfbfa; color:#171717; }
  :global(.legal-page > .container) { width:min(100% - 3rem, 960px); margin-inline:auto; }
  :global(.legal-page .page-shell__intro) { max-width:none; padding:4rem 0 2rem; margin:0; border-bottom:1px solid #d6d3cf; }
  :global(.legal-page .page-shell__intro h1) { font-size:3.5rem; line-height:1.12; letter-spacing:0; overflow-wrap:anywhere; margin:1rem 0; }
  :global(.legal-page .pill) { color:#9b231b; background:none; border:0; padding:0; }
  :global(.legal-page .page-shell__summary) { font-size:1rem; color:#595959; }
  .legal-document {
    display: grid;
    gap: 2rem;
    padding-top: 2.5rem;
    max-width:780px;
    margin-inline:auto;
    line-height: 1.65;
    font-size:1.0625rem;
  }
  .legal-document :global(h2) { font-size:1.75rem; line-height:1.2; letter-spacing:0; color:#171717; }
  .legal-document :global(h3) { font-size:1.25rem; line-height:1.3; letter-spacing:0; }
  .legal-document :global(p), .legal-document :global(li) { color:#333; font-weight:400; overflow-wrap:anywhere; }
  .legal-document :global(section + section) { border-top:1px solid #dedbd7; padding-top:2rem; }
  .legal-document :global(a:focus-visible) { outline:2px solid currentColor; outline-offset:3px; }
  @media(max-width:600px) {
    :global(.legal-page > .container) { width:calc(100% - 2rem); }
    :global(.legal-page .page-shell__intro) { padding-top:2.5rem; }
    :global(.legal-page .page-shell__intro h1) { font-size:2.5rem; }
    .legal-document { font-size:1rem; }
  }

  .legal-document :global(section) {
    display: grid;
    gap: 0.75rem;
  }

  .legal-document :global(h2),
  .legal-document :global(h3),
  .legal-document :global(p),
  .legal-document :global(ul),
  .legal-document :global(ol) {
    margin: 0;
  }

  .legal-document :global(ul),
  .legal-document :global(ol) {
    padding-left: 1.4rem;
  }

  .legal-document :global(a) {
    color: var(--color-red-accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

</style>
