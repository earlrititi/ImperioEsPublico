---
import PageShell from "../layouts/PageShell.astro";
---

<PageShell
  title="Pedido confirmado y detalles de la compra | Imperio Español"
  description="Estamos verificando el pago y el pedido mediante Stripe."
  eyebrow="Confirmacion"
  heading="Estamos verificando tu pedido"
  summary="La compra solo se confirma cuando el webhook firmado de Stripe registra el pago."
  noindex
  narrow
>
  <section class="section content">
    <div class="notice">
      <p>
        Recibiras un correo cuando el pago quede confirmado. Visitar esta pagina no
        activa ni valida por si solo ningun pedido.
      </p>
      <a class="btn btn-primary" href="/tienda">Volver a la tienda</a>
    </div>
  </section>
</PageShell>
