# Site
PUBLIC_SITE_URL=
PUBLIC_GTM_ID=
PUBLIC_GOOGLE_TAG_ID=

# Supabase public
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Supabase private
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Persistent inclusive ES VAT rate, created separately in Test and Live.
STRIPE_ES_VAT_RATE_ID=

# Physical merchandise only. Unset or anything except false keeps payments off.
RESERVATION_MODE=true
RESERVATION_TOKEN_SECRET=
RESERVATION_EXPIRATION_HOURS=0
SHIRT_SALES_APPROVED=false
# disabled | test (redirects every commerce email) | live
COMMERCE_EMAIL_MODE=disabled
COMMERCE_TEST_EMAIL=
COMMERCE_JOB_SECRET=
# Commercial automation requires explicit approval in the server-only runtime table too.
MARKETING_AUTOMATIONS_ENABLED=false
MARKETING_AUTOMATION_CAPTURE_ENABLED=false
MARKETING_CONTACT_VERIFICATION_ENABLED=false
MARKETING_VERIFICATION_SECRET=
MARKETING_CENTRAL_WELCOME_ENABLED=false
MARKETING_SUBSCRIBER_NOTICES_ENABLED=false
# Enable only after the final commercial review; Test prices remain usable.
STRIPE_LIVE_CHECKOUT_ENABLED=false

# Stripe prices
STRIPE_PRICE_ARCABUCERO_MONTHLY=
STRIPE_PRICE_ARCABUCERO_ANNUAL=
STRIPE_PRICE_MAESTRE_CAMPO_MONTHLY=
STRIPE_PRICE_MAESTRE_CAMPO_ANNUAL=
STRIPE_PRICE_CAMISETA_IMPERIAL=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Shared corporate layout; false keeps a semantic fallback for new messages.
EMAIL_PARCHMENT_ENABLED=true
# Explicit admin IDs authorised for bounded audited PII export; empty denies all.
ADMIN_PII_EXPORT_IDS=
# Optional server-only redirect for isolated Stripe Test runs. Never set in Live.
TRANSACTIONAL_EMAIL_TEST_RECIPIENT=
TRANSACTIONAL_EMAIL_TEST_RUN_ID=

# Abuse protection
RATE_LIMIT_SECRET=
# Enable only together with Turnstile CAPTCHA in Supabase Auth.
# Store the private Turnstile secret in Supabase, never in PUBLIC_* or Git.
AUTH_CAPTCHA_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=

# Server only: read-only Google Analytics Data API service account. Never PUBLIC_*.
GA4_SERVICE_ACCOUNT_JSON=

# Private SEO engine: paused by default. Reuses existing maintenance cron.
SEO_ENGINE_ENABLED=false
SEO_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
SEO_AI_API_KEY=
SEO_AI_MODEL=
# Actual provider rates in cents per million tokens; required before reserving spend.
SEO_AI_INPUT_CENTS_PER_MILLION=
SEO_AI_OUTPUT_CENTS_PER_MILLION=
# Optional separate read-only account with access to sc-domain:imperioes.com.
SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=

# Manifiesto email
MANIFESTO_FROM_EMAIL=
MANIFESTO_PDF_URL=
MANIFESTO_PDF_PATH=
MANIFESTO_ATTACHMENT_URL=
MANIFESTO_ATTACHMENT_PATH=

# Post-delivery is paused by default; never backfills orders before this date.
POST_DELIVERY_ENABLED=false
POST_DELIVERY_LOYALTY_ENABLED=false
POST_DELIVERY_ENROLLMENT_STARTS_AT=
POST_DELIVERY_CHECK_DELAY_HOURS=48
POST_DELIVERY_LOYALTY_DELAY_HOURS=72

# Server only: signed Supabase Auth delivery. Enable the remote hook only after QA.
SUPABASE_AUTH_EMAIL_HOOK_SECRET=
AUTH_MAIL_IDEMPOTENCY_SECRET=
# Metadata only; never stores authentication links, OTPs or message bodies.
CORPORATE_MAIL_AUDIT_ENABLED=true

# Optional server-only fallback; the admin mailbox normally uses encrypted Vault storage.
IONOS_IMAP_PASSWORD=
