---
import PageShell from "../layouts/PageShell.astro";
import PasswordField from "../components/PasswordField.astro";
import { authError, privateAuthHeaders, readAuthForm, validEmail } from "../lib/auth-forms";
import { safeInternalPath } from "../lib/redirects";
import { createSupabaseServerClient } from "../lib/supabase/server";
privateAuthHeaders(Astro.response.headers);
const error = Astro.url.searchParams.get("error");
const updated = Astro.url.searchParams.get("updated") === "1";
const next = safeInternalPath(Astro.url.searchParams.get("next"), "/cuenta");
const fail = (code: string) => Astro.redirect(`/login?error=${code}&next=${encodeURIComponent(next)}`, 303);
if (Astro.request.method === "POST") {
  try {
    const form = await readAuthForm(Astro.request, "auth_login");
    const email = String(form.get("email") ?? "").trim().toLowerCase();
    if (!validEmail(email)) return fail("validation");
    const supabase = createSupabaseServerClient({ cookies: Astro.cookies, request: Astro.request });
    if (form.get("method") === "magic") {
      const site = (import.meta.env.PUBLIC_SITE_URL || Astro.url.origin).replace(/\/$/, "");
      await supabase.auth.signInWithOtp({ email, options: { shouldCreateUser: false,
        emailRedirectTo: `${site}/api/auth/callback?next=${encodeURIComponent(next)}` } });
      return Astro.redirect(`/login?sent=1&next=${encodeURIComponent(next)}`, 303);
    }
    const password = form.get("password") ?? "";
    if (!password || password.length > 256) return fail("credentials");
    const { data, error: signInError } = await supabase.auth.signInWithPassword({ email, password });
    if (signInError || !data.user) return fail("credentials");
    return Astro.redirect(next, 303);
  } catch (e) { return fail(authError(e)); }
}
---
<PageShell title="Iniciar sesión | Imperio Español" description="Accede a tu cuenta." eyebrow="Acceso privado" heading="Iniciar sesión" noindex narrow mainClass="auth-page">
  <Fragment slot="header">
    <div class="auth-panel">
      <p class="auth-panel__lede">Accede a tu archivo, tus reservas y tu suscripción.</p>
      {updated && <p class="auth-notice" role="status">Contraseña guardada. Ya puedes iniciar sesión.</p>}
      {error && <p class="auth-notice auth-notice--error" role="alert">{error === "rate" ? "Demasiados intentos. Espera unos minutos." : error === "credentials" ? "No se pudo iniciar sesión. Revisa el correo, la contraseña y la confirmación de tu cuenta." : "No se pudo completar la solicitud. Inténtalo de nuevo."}</p>}
      <form class="auth-form" method="post">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="username" maxlength="254" required />
        <PasswordField />
        <button class="btn btn-primary auth-form__submit" type="submit">Iniciar sesión</button>
      </form>
      <a class="auth-secondary" href="/recuperar-contrasena">¿Has olvidado tu contraseña?</a>
      <div class="auth-register">
        <p>¿No tienes cuenta?</p>
        <a href={`/registro?next=${encodeURIComponent(next)}`}>Crear cuenta</a>
      </div>
      <a class="auth-secondary" href="/confirmar-correo">Reenviar confirmación</a>
    </div>
  </Fragment>
</PageShell>
<style>
  :global(.auth-page .page-shell__intro) { max-width:660px; margin-inline:auto; }
  :global(.auth-page .page-shell__intro > .pill) { justify-self:start; }
  .auth-panel { position:relative; margin-top:0.5rem; padding:clamp(1.25rem,4vw,2.4rem); background:#fff; border-block:1px solid var(--line); }
  .auth-panel::before { content:""; position:absolute; top:-1px; left:0; width:5rem; height:3px; background:var(--color-gold); }
  .auth-panel__lede { margin:0 0 1.5rem; font-family:var(--font-serif); font-size:1.25rem; }
  .auth-form { display:grid; gap:0.65rem; }
  .auth-form > label, :global(.auth-form .password-label) { margin-top:0.4rem; font-size:0.82rem; font-weight:700; text-transform:uppercase; }
  .auth-form > input { min-height:48px; border:1px solid #9c978f; border-radius:4px; padding:0.75rem; font:inherit; width:100%; min-width:0; background:#fff; }
  .auth-form__submit { width:100%; min-height:50px; margin-top:0.75rem; text-transform:uppercase; }
  .auth-notice { margin:0 0 1rem; padding:0.75rem 1rem; border-left:3px solid var(--color-gold); background:#f7f4ee; }
  .auth-notice--error { border-left-color:var(--color-red-accent); }
  .auth-secondary { display:inline-block; margin-top:1rem; font-size:0.9rem; text-decoration:underline; text-underline-offset:3px; }
  .auth-register { display:flex; align-items:baseline; gap:0.55rem; margin-top:1.75rem; padding-top:1.25rem; border-top:1px solid var(--line); }
  .auth-register p { margin:0; }
  .auth-register a { color:var(--color-red-deep); font-weight:700; text-decoration:underline; text-underline-offset:3px; }
  a:focus-visible { outline:2px solid currentColor; outline-offset:4px; }
  @media (max-width:600px) {
    :global(.auth-page) { padding-inline:12px; }
    .auth-panel { padding-inline:1rem; }
    .auth-register { align-items:flex-start; flex-direction:column; }
  }
</style>
