---
import "../styles/global.css";
import "../styles/navigation.css";
import ClientRuntime from "../islands/ClientRuntime.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Footer from "../components/Footer.jsx";
import GlobalHomeMark from "../components/GlobalHomeMark.astro";
import Navigation from "../components/Navigation.jsx";
import { SITE } from "../config/site";
import { withBase } from "../utils/basePath";
import { canonicalUrl as buildCanonicalUrl, hasSearchParameters, serializeJsonLd } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  footerVariant?: "light" | "dark";
  showFooter?: boolean;
  showCookieConsent?: boolean;
  navigation?: "persistent" | "home";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: "website" | "article";
  publishedAt?: string;
  modifiedAt?: string;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  ogImage = SITE.defaultOgImage,
  noindex = false,
  footerVariant = "light",
  showFooter = true,
  showCookieConsent = true,
  navigation = "persistent",
  structuredData,
  ogType = "website",
  publishedAt,
  modifiedAt,
} = Astro.props as Props;

const pageTitle =
  title === SITE.name || title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const isGitHubPagesBuild = import.meta.env.BASE_URL.startsWith("/Imperio_web");
const deploymentOrigin =
  isGitHubPagesBuild ? "https://earlrititi-lang.github.io" : SITE.url;
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);
const excluded = noindex || hasSearchParameters(Astro.url) || (Astro.response.status ?? 200) >= 400;
const ogImageUrl = new URL(withBase(ogImage), deploymentOrigin).toString();
const organizationSchema = {
  "@type": "Organization",
  "@id": `${SITE.url}/#organization`,
  name: SITE.name,
  alternateName: SITE.alternateName,
  url: SITE.url,
  logo: new URL("/images/logo-redv2.png", SITE.url).toString(),
  email: SITE.contactEmail,
  description: SITE.defaultDescription,
  sameAs: SITE.sameAs,
};
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [organizationSchema, {
    "@type": "WebSite", "@id": `${SITE.url}/#website`, name: SITE.name,
    url: SITE.url, inLanguage: "es", publisher: { "@id": `${SITE.url}/#organization` },
  }, {
    "@type": "WebPage", "@id": `${canonicalUrl}#webpage`, url: canonicalUrl,
    name: pageTitle, description, inLanguage: "es", isPartOf: { "@id": `${SITE.url}/#website` },
  }, ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={excluded ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="x-runtime-stack" content="astro,google-tag,cloudflare-ready" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    {ogType === "article" && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {ogType === "article" && modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="alternate" type="application/rss+xml" title={`Artículos de ${SITE.name}`} href={withBase("/feed.xml")} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${withBase("/favicon-32x32.png")}?v=20260902`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${withBase("/favicon-16x16.png")}?v=20260902`}
    />
    <link rel="icon" href={`${withBase("/favicon.ico")}?v=20260902`} sizes="any" />
    <link rel="shortcut icon" href={`${withBase("/favicon.ico")}?v=20260902`} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={withBase("/apple-touch-icon.png")}
    />
    <link rel="manifest" href={withBase("/site.webmanifest")} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="application-name" content={SITE.name} />
    <meta name="theme-color" content="#f2381e" />
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(jsonLd)}
    ></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://db.onlinewebfonts.com/c/35da23d6d7d68a326080792c63a6251b?family=FS+Rosa+Black"
      rel="stylesheet"
    />
  </head>
  <body>
    <noscript><style is:global>.fade-in-up, .reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <GlobalHomeMark />
    {navigation === "persistent" && <Navigation persistent />}
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    {showFooter && <Footer variant={footerVariant} />}
    <div id="imperio-scrollbar" aria-hidden="true">
      <div id="imperio-scrollbar-track">
        <div id="imperio-scrollbar-thumb"></div>
      </div>
    </div>
    <ClientRuntime />
    {showCookieConsent && <CookieConsent />}
  </body>
</html>
