---
// Shared shell for internal pages so metadata, spacing, and intro blocks stay consistent.
import Layout from "./Layout.astro";

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  heading: string;
  summary?: string;
  summaryMuted?: boolean;
  narrow?: boolean;
  mainClass?: string;
  noindex?: boolean;
  showCookieConsent?: boolean;
  footerVariant?: "light" | "dark";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  ogType?: "website" | "article";
  publishedAt?: string;
  modifiedAt?: string;
}

const {
  title,
  description,
  eyebrow,
  heading,
  summary,
  summaryMuted = false,
  narrow = false,
  mainClass = "",
  noindex = false,
  showCookieConsent = true,
  footerVariant = "light",
  structuredData,
  ogImage,
  ogType,
  publishedAt,
  modifiedAt,
} = Astro.props as Props;
---

<Layout
  title={title}
  description={description}
  noindex={noindex}
  showCookieConsent={showCookieConsent}
  footerVariant={footerVariant}
  structuredData={structuredData}
  ogImage={ogImage}
  ogType={ogType}
  publishedAt={publishedAt}
  modifiedAt={modifiedAt}
>
  <main class:list={["page-shell", mainClass]}>
    <div class="container">
      <section class:list={["section", "page-shell__intro", narrow && "content"]}>
        <slot name="meta" />
        {eyebrow && <span class="pill">{eyebrow}</span>}
        <h1>{heading}</h1>
        {summary && <p class:list={["page-shell__summary", summaryMuted && "muted"]}>{summary}</p>}
        <slot name="header" />
      </section>
      <slot />
    </div>
  </main>
</Layout>
