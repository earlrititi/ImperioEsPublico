---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../config/site";
import { withBase } from "../utils/basePath";
import BrandLogo from "../components/BrandLogo";
---

<Layout
  title="Todos nuestros enlaces | Imperio Español"
  description="Redes sociales, web, tienda, newsletter y contacto de Imperio Español en un solo lugar."
  navigation="home"
  footerVariant="dark"
  showFooter={false}
>
  <main class="links-page" data-home-mark-surface="black">
    <div class="links-shell">
      <header class="links-header">
        <a class="links-avatar" href={withBase("/")} aria-label="Ir a la portada de Imperio Español">
          <BrandLogo variant="principal" width={112} decorative />
        </a>
        <p class="links-kicker">Historia · Cultura · Memoria</p>
        <h1 class="links-title">Imperio Español</h1>
        <p class="links-subtitle">Todos nuestros enlaces en un solo lugar.</p>
      </header>

      <nav class="links-stack" aria-label="Enlaces de Imperio Español">
        <section class="links-group" aria-labelledby="links-destacados">
          <h2 id="links-destacados" class="links-group__title">Destacado</h2>
          <ul class="links-list">
            <li>
              <a class="links-button links-button--primary" href={withBase("/")}>
                <span class="links-button__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18" />
                    <path d="M12 3c2.5 2.4 3.8 5.4 3.8 9s-1.3 6.6-3.8 9c-2.5-2.4-3.8-5.4-3.8-9S9.5 5.4 12 3Z" />
                  </svg>
                </span>
                <span class="links-button__copy">
                  <span class="links-button__label">Visitar la web</span>
                  <span class="links-button__meta">imperioes.com</span>
                </span>
                <span class="links-button__arrow" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a class="links-button" href={withBase("/instagram")}>
                <span class="links-button__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 4 4.5 6.5 6 10l2-1v11h8V9l2 1 1.5-3.5L16 4a4 4 0 0 1-8 0Z" />
                  </svg>
                </span>
                <span class="links-button__copy">
                  <span class="links-button__label">Camiseta Imperial</span>
                  <span class="links-button__meta">NON SUFFICIT ORBIS · Primera edición</span>
                </span>
                <span class="links-button__arrow" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a class="links-button" href={withBase("/tienda")}>
                <span class="links-button__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 8h12l1 12H5L6 8Z" />
                    <path d="M9 8V6a3 3 0 0 1 6 0v2" />
                  </svg>
                </span>
                <span class="links-button__copy">
                  <span class="links-button__label">Tienda</span>
                  <span class="links-button__meta">Catálogo y novedades</span>
                </span>
                <span class="links-button__arrow" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a class="links-button" href={withBase("/newsletter")}>
                <span class="links-button__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                </span>
                <span class="links-button__copy">
                  <span class="links-button__label">Newsletter</span>
                  <span class="links-button__meta">7 historias del Siglo de Oro en PDF</span>
                </span>
                <span class="links-button__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        </section>

        <section class="links-group" aria-labelledby="links-redes">
          <h2 id="links-redes" class="links-group__title">Redes sociales</h2>
          <ul class="links-list">
            <li>
              <a
                class="links-button"
                href="https://www.instagram.com/imperio_e/"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="links-button__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                  </svg>
                </span>
                <span class="links-button__copy">
                  <span class="links-button__label">Instagram</span>
                  <span class="links-button__meta">@imperio_e</span>
                </span>
                <span class="links-button__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a
                class="links-button"
                href="https://www.facebook.com/ElMayorImperioDeTodos/"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="links-button__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                  </svg>
                </span>
                <span class="links-button__copy">
                  <span class="links-button__label">Facebook</span>
                  <span class="links-button__meta">Imperio Español</span>
                </span>
                <span class="links-button__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a
                class="links-button"
                href="https://x.com/Imperio_e"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="links-button__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z" />
                  </svg>
                </span>
                <span class="links-button__copy">
                  <span class="links-button__label">X</span>
                  <span class="links-button__meta">@Imperio_e</span>
                </span>
                <span class="links-button__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </section>

        <section class="links-group" aria-labelledby="links-contacto">
          <h2 id="links-contacto" class="links-group__title">Contacto</h2>
          <ul class="links-list">
            <li>
              <a class="links-button" href={`mailto:${SITE.contactEmail}`}>
                <span class="links-button__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                </span>
                <span class="links-button__copy">
                  <span class="links-button__label">Escríbenos</span>
                  <span class="links-button__meta">{SITE.contactEmail}</span>
                </span>
                <span class="links-button__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        </section>
      </nav>

      <footer class="links-footer">
        <p class="links-footer__contact">
          © {new Date().getFullYear()} Imperio Español · <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        </p>
        <ul class="links-legal" aria-label="Información legal">
          <li><a href={withBase("/legal/aviso-legal")}>Aviso legal</a></li>
          <li><a href={withBase("/legal/privacidad")}>Privacidad</a></li>
          <li><a href={withBase("/legal/cookies")}>Cookies</a></li>
        </ul>
      </footer>
    </div>
  </main>
</Layout>

<style>
  :global(body:has(.links-page)) {
    background: #0b0c0c;
    color-scheme: dark;
  }

  :global(body:has(.links-page) .global-home-mark) {
    display: none;
  }

  .links-page {
    --links-max: 560px;
    position: relative;
    min-height: 100svh;
    padding: max(2.75rem, env(safe-area-inset-top)) 1.25rem max(2rem, env(safe-area-inset-bottom));
    overflow: hidden;
    background:
      radial-gradient(circle at 50% -10%, rgba(242, 56, 30, 0.3), transparent 42%),
      radial-gradient(circle at 100% 100%, rgba(212, 175, 55, 0.08), transparent 38%),
      #0b0c0c;
    color: #fafafa;
    font-family: var(--font-body);
  }

  .links-page::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.18) 0.7px, transparent 0.7px);
    background-size: 18px 18px;
    opacity: 0.16;
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 75%);
    mask-image: linear-gradient(to bottom, #000, transparent 75%);
    pointer-events: none;
  }

  .links-page::after {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: min(78vw, 620px);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(242, 56, 30, 0.85), transparent);
    box-shadow: 0 0 24px rgba(242, 56, 30, 0.55);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .links-shell {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    width: min(100%, var(--links-max));
    margin: 0 auto;
  }

  .links-header {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    padding-top: 0.5rem;
    text-align: center;
  }

  .links-avatar {
    display: grid;
    place-items: center;
    width: 112px;
    aspect-ratio: 1;
    padding: 16px;
    border: 1px solid rgba(212, 175, 55, 0.5);
    border-radius: 50%;
    background: #f7f4ee;
    box-shadow: 0 0 0 8px rgba(242, 56, 30, 0.08), 0 18px 50px rgba(0, 0, 0, 0.5);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .links-avatar:hover,
  .links-avatar:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 0 0 10px rgba(242, 56, 30, 0.1), 0 22px 56px rgba(0, 0, 0, 0.55);
  }

  .links-avatar:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }

  .links-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .links-kicker {
    margin: 0.75rem 0 0;
    color: var(--color-gold);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .links-title {
    margin: 0;
    font-family: var(--font-rosa-black), var(--font-display);
    font-size: clamp(1.75rem, 7vw, 2.45rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .links-subtitle {
    max-width: 34ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .links-stack {
    display: grid;
    gap: 1.5rem;
  }

  .links-group {
    display: grid;
    gap: 0.7rem;
  }

  .links-group__title {
    margin: 0 0 0.1rem;
    padding-left: 0.35rem;
    color: rgba(255, 255, 255, 0.48);
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .links-list {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links-button {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 60px;
    padding: 0.7rem 0.9rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.055);
    color: #fff;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .links-button::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(242, 56, 30, 0.22), transparent 55%);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .links-button:hover,
  .links-button:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(242, 56, 30, 0.7);
    background: rgba(255, 255, 255, 0.09);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.3);
  }

  .links-button:hover::before,
  .links-button:focus-visible::before {
    opacity: 1;
  }

  .links-button:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  .links-button--primary {
    border-color: var(--color-red-accent);
    background: var(--color-red-accent);
  }

  .links-button--primary .links-button__icon {
    background: rgba(0, 0, 0, 0.16);
    color: #fff;
  }

  .links-button--primary .links-button__meta {
    color: rgba(255, 255, 255, 0.78);
  }

  .links-button--primary:hover,
  .links-button--primary:focus-visible {
    border-color: #ff5a40;
    background: #ff4a2f;
  }

  .links-button__icon {
    position: relative;
    z-index: 1;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .links-button__icon svg {
    display: block;
    width: 22px;
    height: 22px;
  }

  .links-button__copy {
    position: relative;
    z-index: 1;
    display: grid;
    flex: 1 1 auto;
    gap: 0.12rem;
    min-width: 0;
  }

  .links-button__label {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .links-button__meta {
    overflow: hidden;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .links-button__arrow {
    position: relative;
    z-index: 1;
    color: rgba(255, 255, 255, 0.4);
    font-size: 1.05rem;
  }

  .links-footer {
    display: grid;
    justify-items: center;
    gap: 0.65rem;
    padding-top: 1rem;
    text-align: center;
  }

  .links-footer__contact {
    margin: 0;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.78rem;
  }

  .links-footer__contact a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .links-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.7rem;
  }

  .links-legal a {
    color: rgba(255, 255, 255, 0.42);
    text-decoration: none;
  }

  .links-legal a:hover,
  .links-legal a:focus-visible,
  .links-footer__contact a:hover,
  .links-footer__contact a:focus-visible {
    color: #fff;
  }

  @media (max-width: 480px) {
    .links-page {
      padding-inline: 1rem;
    }

    .links-avatar {
      width: 92px;
      padding: 13px;
    }

    .links-button {
      min-height: 58px;
      gap: 0.75rem;
      padding: 0.65rem 0.75rem;
    }

    .links-button__icon {
      width: 36px;
      height: 36px;
    }

    .links-button__label {
      font-size: 0.95rem;
    }

    .links-button__meta {
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links-avatar,
    .links-button,
    .links-button::before {
      transition: none;
    }
  }
</style>
