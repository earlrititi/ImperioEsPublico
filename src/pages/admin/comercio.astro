---
import AdminShell from "../../layouts/AdminShell.astro";
import CommerceAdmin from "../../components/commerce/CommerceAdmin";
import { requireAdmin } from "../../lib/reservations";
import "../../styles/commerce.css";
export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
try { await requireAdmin(Astro); } catch { return Astro.redirect('/login?next=/admin/comercio'); }
---
<AdminShell title="Reservas, pedidos y stock"><CommerceAdmin client:load/></AdminShell>
