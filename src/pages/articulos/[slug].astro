---
import { publishedArticles } from "../../lib/published-articles";
export const prerender=false;
const article = (await publishedArticles()).find(item => item.slug === Astro.params.slug);
if (!article) return new Response("Articulo no encontrado", { status: 404 });
return Astro.redirect(`${article.href}${Astro.url.search}`, 301);
